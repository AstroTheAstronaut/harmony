<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>Harmony</title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
  <link rel="stylesheet" href="/styles/upload-style.css">
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

</head>

<body id="page-top">
  <div id="wrapper">
    <%- include('partials/sidebar') %>
    <div class="d-flex flex-column" id="content-wrapper">
      <%- include('partials/navbar') %>
      <div class="container-fluid">
        <div class="d-sm-flex justify-content-between align-items-center mb-4">
          <h3 class="text-dark mb-0">Upload a song</h3>
        </div>
        <div class="card shadow mb-4">
          <div class="container my-4">
          <form id="uploadForm" action="/upload/upload-song" method="post" enctype="multipart/form-data">
            <div class="row">
              <!-- Song Parts Column -->
              <div class="col-md-6">
                <div class="form-group">
                  <label for="title">Title</label>
                  <input type="text" id="title" name="title" class="form-control" required>
                </div>
                <div class="form-group">
                  <label for="artist">Artist</label>
                  <input type="text" id="artist" name="artist" class="form-control">
                </div>
                <div class="form-group">
                  <label for="partType">Part Type</label>
                  <select id="partType" class="form-control" required>
                    <option value="Verse">Verse</option>
                    <option value="Chorus">Chorus</option>
                    <option value="Bridge">Bridge</option>
                    <option value="Coda">Coda</option>
                    <option value="Intro">Intro</option>
                    <option value="Outro">Outro</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="book">Book</label>
                  <select id="book" name="book" class="form-control">
                    <option value="">Select a book (optional)</option>
                    <% books.forEach(book => { %>
                      <option value="<%= book.bo_uid %>">
                        <%= book.bo_name %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="form-group">
                  <label for="bookSongNumber">Song Number in Book</label>
                  <input type="number" id="bookSongNumber" name="bookSongNumber" class="form-control">
                </div>
                <div class="form-group">
                  <label for="lyricsPart">Lyrics</label>
                  <textarea id="lyricsPart" name="lyricsPart" class="form-control" rows="4" required></textarea>
                </div>
                <button type="button" id="addPart" class="btn btn-primary">Add Part</button>
                <input type="file" id="fileInput" accept=".lyric" class="form-control mt-2">
                <button type="button" id="importButton" class="btn btn-secondary mt-2">Import from File</button>
      
                <input type="hidden" id="parts" name="parts">
                <br>
                <button type="submit" class="btn btn-success mt-4">Upload</button>
                <a href="/" class="btn btn-secondary mt-4">Back to Home</a>
              </div>
      
              <!-- Preview Column (Interactive) -->
              <div class="col-md-6">
                <h2 class="mt-4 fst-italic">Preview</h2>
                <div id="preview" class="preview-container">
                  <ul id="sortablePreview" class="list-unstyled">
                    <!-- Interactive preview content will be injected here -->
                  </ul>
                </div>
                
              </div>
            </div>
          </form>
      
          <!-- Dropdown for changing part type -->
          <select id="typeDropdown" class="form-control mt-2" style="display: none;">
            <option value="Verse">Verse</option>
            <option value="Chorus">Chorus</option>
            <option value="Bridge">Bridge</option>
            <option value="Coda">Coda</option>
            <option value="Intro">Intro</option>
            <option value="Outro">Outro</option>
          </select>
        </div>
        </div>
        
      </div>
      <footer class="bg-white sticky-footer">
        <div class="container my-auto">
            <div class="text-center my-auto copyright"><span>Harmony App<br>All glory be to God!</span>
            </div>
        </div>
    </footer>
    </div>
    <a class="border rounded d-inline scroll-to-top" href="#page-top"><i class="fas fa-angle-up"></i></a>
  </div>
  

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"
    integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
    crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.6.0/jszip.min.js"></script>
  <script src="/scripts/upload-script.js"></script>
</body>

</html>
