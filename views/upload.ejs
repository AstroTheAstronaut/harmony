<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('upload.upload') %> - <%= t('general.harmony') %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
  <link rel="stylesheet" href="/styles/upload-style.css">
  <script src="
  https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js
  "></script>  
</head>

<body id="page-top">
  <div id="wrapper">
    <%- include('partials/sidebar') %>
    <div class="d-flex flex-column" id="content-wrapper" style="justify-content: space-between;">
      <%- include('partials/navbar') %>
      <div class="container-fluid">
        <div class="d-sm-flex justify-content-between align-items-center mb-4">
          <h3 class="text-dark mb-0"><%= t('upload.upload_song_head_title') %></h3>
        </div>
        <div class="card shadow mb-4">
          <div class="container my-4">
          <form id="uploadForm" action="/upload/upload-song" method="post" enctype="multipart/form-data">
            <div class="row">
              <!-- Song Parts Column -->
              <div class="col-md-6">
                <div class="form-group">
                  <label for="title"><%= t('song.title') %></label>
                  <input type="text" id="title" name="title" class="form-control" required>
                </div>
                <div class="form-group">
                  <label for="artist"><%= t('song.artist') %></label>
                  <input type="text" id="artist" name="artist" class="form-control">
                </div>
                <div class="form-group">
                  <label for="chord"><%= t('song.chord') %></label>
                  <select id="chord" name="chord" class="form-control"></select>
                </div>
                <div class="form-group">
                  <label for="book"><%= t('book.book') %></label>
                  <select id="book" name="book" class="form-control">
                    <option value=""><%= t('general.select_book_opt') %></option>
                    <% books.forEach(book => { %>
                      <option value="<%= book.bo_uid %>">
                        <%= book.bo_name %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="form-group">
                  <label for="bookSongNumber"><%= t('song.song_no_in_bo') %></label>
                  <input type="number" id="bookSongNumber" name="bookSongNumber" class="form-control">
                </div>
                <div class="form-group">
                  <label for="partType"><%= t('song.part_type') %></label>
                  <select id="partType" class="form-control" required>
                    <option value="Verse"><%= t('song_parts.verse') %></option>
                    <option value="Chorus"><%= t('song_parts.chorus') %></option>
                    <option value="Bridge"><%= t('song_parts.bridge') %></option>
                    <option value="Coda"><%= t('song_parts.coda') %></option>
                    <option value="Intro"><%= t('song_parts.intro') %></option>
                    <option value="Outro"><%= t('song_parts.outro') %></option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="lyricsPart"><%= t('song.lyrics') %></label>
                  <textarea id="lyricsPart" name="lyricsPart" class="form-control" rows="4" required></textarea>
                </div>
                <button type="button" id="addPart" class="btn btn-primary"><%= t('general.add_part') %></button>
                <input type="file" id="fileInput" accept=".lyric" class="form-control mt-2">
                <button type="button" id="importButton" class="btn btn-secondary mt-2"><%= t('upload.import_from_file') %></button>
      
                <input type="hidden" id="parts" name="parts">
                <br>
                <button type="submit" class="btn btn-success mt-4"><%= t('upload.upload') %></button>
              </div>
      
              <!-- Preview Column (Interactive) -->
              <div class="col-md-6">
                <h2 class="mt-4 fst-italic"><%= t('general.preview') %></h2>
                <div id="previewContainer" class="preview-container">
                  <div id="previewTitleContainer" class="previewTitleContainer">
                    <span id="previewSongNumber"></span>
                    <span id="previewTitle"></span>
                  </div>
                  <div id="previewArtist" class="previewArtist"></div>
                  <div id="previewChordContainer" class="previewChordContainer" style="display: none;">
                    <strong><%= t('song.chord') %>: </strong><span id="previewChord"></span>
                  </div>
                  <div id="previewBook"></div>
                  <div id="previewPartsContainer">
                  </div>
                </div>
              </div>
            </div>
          </form>
      
          <!-- Dropdown for changing part type -->
          <select id="typeDropdown" class="form-control mt-2" style="display: none;">
            <option value="Verse"><%= t('song_parts.verse') %></option>
            <option value="Chorus"><%= t('song_parts.chorus') %></option>
            <option value="Bridge"><%= t('song_parts.bridge') %></option>
            <option value="Coda"><%= t('song_parts.coda') %></option>
            <option value="Intro"><%= t('song_parts.intro') %></option>
            <option value="Outro"><%= t('song_parts.outro') %></option>
          </select>
        </div>
        </div>
        
      </div>
      <%- include('partials/footer') %>
    </div>
    
  </div>
  

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"
    integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
    crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.6.0/jszip.min.js"></script>
  <script src="/scripts/upload-script.js"></script>
  <script>
    const chords = [
    "C", "Cm", "C#", "C#m", "D", "Dm", "D#", "D#m",
    "E", "Em", "F", "Fm", "F#", "F#m", "G", "Gm",
    "G#", "G#m", "A", "Am", "A#", "A#m", "B", "Bm"
  ];
    const chordSelect = document.getElementById("chord");
    // Placeholder
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "<%= t('upload.select_chord_opt') %>";
    placeholder.disabled = true;
    placeholder.selected = true;
    chordSelect.appendChild(placeholder);
    // Add the actual chord options
    chords.forEach(chord => {
      const option = document.createElement("option");
      option.value = chord;
      option.textContent = chord;
      chordSelect.appendChild(option);
    });
  </script>
</body>

</html>
