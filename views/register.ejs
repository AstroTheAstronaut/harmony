<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('register_page.register') %> - <%= t('general.harmony') %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/3.4.3/css/flag-icon.min.css" />
    
    <style>
        body {
            background-image: url('/img/login-bg50-min.jpg');
            background-size: cover;
            color: #333;
        }

        .card {
            border-radius: 0.5rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .card-body {
            padding: 30px;
        }

        .btn-custom {
            background-color: #007bff;
            color: #fff;
            border-radius: 0.375rem;
            margin-bottom: 15px;
            width: 100% !important;
            padding: 10px;
            font-size: 1rem;
        }

        .btn-custom:hover {
            background-color: #0056b3;
        }

        .form-group {
            margin-top: 20px;
        }

        #loginBtn {
            width: 100%;
            border-radius: 0.375rem;
            margin-top: 10px;
        }

        h2 {
            margin-bottom: 30px;
            color: #333;
            text-align: center;
        }

        /* Center the card */
        .centered-card {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .card {
            width: 100%;
            max-width: 400px;
        }

        .hidden {
            display: none;
        }
        .label-warning {
            color: red;
            font-size: 0.85rem;
            display: none;
            margin-top: 0.25rem;
        }
        @media (max-width: 576px) {
            body {
                background-image: none !important;
            }
        }
        @media (max-width: 768px) {
                body{
                background-image: none !important;
            }
        }

    </style>
</head>

<body>
    <div class="container-fluid centered-card">
        <div class="card shadow">
            <div class="card-header py-3 text-center">
                <h3 class="text-primary fw-bold m-0"><%= t('register_page.friendly_message') %></h3>
            </div>
            <div class="card-body">
            <form id="loginForm" action="/auth/register-user" method="POST">
                <div class="form-group mb-2">
                    <span class="label d-block mb-1">
                        <%= t('login_page.username') %>:
                    </span>
                    <input id="usernameInput" type="text" name="username" class="form-control mb-2" placeholder="<%= t('login_page.username') %>" required>
                    <span class="text-danger small d-none">Username already taken!</span>
                    <span class="label d-block mb-1">
                        <%= t('register_page.email') %>:
                    </span>
                    <input id="emailInput" type="email" name="email" class="form-control mb-2" placeholder="<%= t('register_page.email') %>" required>
                    <span class="text-danger small d-none">Email already taken!</span>
                    <span class="label d-block mb-1">
                        <%= t('login_page.password') %>:
                    </span>
                    <span class="text-warning small d-none">Password should be at least 6 characters!</span>
                    <input id="passwordInput" type="password" name="password" class="form-control" placeholder="<%= t('login_page.password') %>" required>
                    <span class="label d-block mb-1">
                        <%= t('register_page.confirm_password') %>:
                    </span>
                    <input id="confirmPasswordInput" type="password" name="confirmPassword" class="form-control" placeholder="<%= t('register_page.confirm_password') %>" required>
                    <span class="text-danger small d-none">Password don't match!</span>
                    <span class="label d-block mb-1">
                        <%= t('register_page.register_code') %>:
                    </span>
                    <input id="registerCodeInput" type="text" name="registerCode" class="form-control mb-2" placeholder="<%= t('register_page.register_code') %>" required>
                    <span class="text-danger small d-none">Invalid registration code!</span>
                    
                </div>

                <div class="mb-2">
                    <span class="label">
                        <%= t('register_page.already_account') %>
                        <a href="/login"><%= t('general.click_here') %></a>
                    </span>
                </div>

                <button type="submit" id="registerBtn" class="btn btn-custom w-100 mb-2">
                    <%= t('register_page.register') %>
                </button>
            </form>
        </div>

            <div class="card-footer text-center">
                <span class="d-block mb-2 h5">
                    <em><%= t('general.footer_verse') %></em>
                </span>
            </div>
        </div>

        <!-- Language Dropdown -->
        <div class="dropdown language-switcher position-absolute top-0 end-0 p-3">
            <a class="dropdown-toggle nav-link" aria-expanded="false" data-bs-toggle="dropdown" href="#">
                <% if (i18n.language === 'en') { %>
                    <span class="flag-icon flag-icon-gb"></span>
                <% } else if (i18n.language === 'it') { %>
                    <span class="flag-icon flag-icon-it"></span>
                <% } else if (i18n.language === 'ro') { %>
                    <span class="flag-icon flag-icon-ro"></span>
                <% } else if (i18n.language === 'es') { %>
                    <span class="flag-icon flag-icon-es"></span>
                <% } %>
            </a>
            <div class="dropdown-menu dropdown-menu-end animated--grow-in">
                <h6 class="dropdown-header"><%= t('messages.change_language') %></h6>
                <a class="dropdown-item" href="/change-language/en">
                    <span class="flag-icon flag-icon-gb"></span> <%= t('messages.english') %>
                </a>
                <a class="dropdown-item" href="/change-language/it">
                    <span class="flag-icon flag-icon-it"></span> <%= t('messages.italian') %>
                </a>
                <a class="dropdown-item" href="/change-language/ro">
                    <span class="flag-icon flag-icon-ro"></span> <%= t('messages.romanian') %>
                </a>
                <a class="dropdown-item" href="/change-language/es">
                    <span class="flag-icon flag-icon-es"></span> <%= t('messages.spanish') %>
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script>
        const usernameInput = document.getElementById('usernameInput');
        const emailInput = document.getElementById('emailInput');
        const passwordInput = document.getElementById('passwordInput');
        const confirmPasswordInput = document.getElementById('confirmPasswordInput');
        const registerCodeInput = document.getElementById('registerCodeInput');
        const registerBtn = document.getElementById('registerBtn');

        let debounceTimeout;

        usernameInput.addEventListener('input', () => {
            clearTimeout(debounceTimeout);

            debounceTimeout = setTimeout(() => {
                const username = usernameInput.value.trim();
                if (username.length === 0) {
                    document.querySelector('#usernameInput + .text-danger').classList.add('d-none');
                    registerBtn.disabled = false;
                    return;
                }

                fetch('/check-username', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ username })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.exists) {
                            console.log('Username is taken');
                            document.querySelector('#usernameInput + .text-danger').classList.remove('d-none');
                            registerBtn.disabled = true;
                        } else {
                            console.log('Username available');
                            document.querySelector('#usernameInput + .text-danger').classList.add('d-none');
                            registerBtn.disabled = false;
                        }
                    })
                    .catch(err => {
                        console.error('Error checking username:', err);
                    });
            }, 300);
        });

        emailInput.addEventListener('input', () => {
            clearTimeout(debounceTimeout);

            debounceTimeout = setTimeout(() => {
                const email = emailInput.value.trim();
                if (email.length === 0) {
                    document.querySelector('#emailInput + .text-danger').classList.add('d-none');
                    registerBtn.disabled = false;
                    return;
                }

                fetch('/check-email', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.exists) {
                            console.log('Email is taken');
                            document.querySelector('#emailInput + .text-danger').classList.remove('d-none');
                            registerBtn.disabled = true;
                        } else {
                            console.log('Email available');
                            document.querySelector('#emailInput + .text-danger').classList.add('d-none');
                            registerBtn.disabled = false;
                        }
                        
                    })
                    .catch(err => {
                        console.error('Error checking email:', err);
                    });

            }, 1400);
        });

        function checkPasswordsMatch() {
            const password = passwordInput.value.trim();
            const confirmPassword = confirmPasswordInput.value.trim();

            if (confirmPassword.length > 0 && password !== confirmPassword) {
                document.querySelector('#confirmPasswordInput + .text-danger').classList.remove('d-none');
                registerBtn.disabled = true;
            } else {
                document.querySelector('#confirmPasswordInput + .text-danger').classList.add('d-none');
                registerBtn.disabled = false;
            }
        }

        passwordInput.addEventListener('input', () => {
            document.querySelector('#confirmPasswordInput + .text-danger').classList.add('d-none');
            registerBtn.disabled = false;
        });

        if (passwordInput.legnth() < 6) {
            document.querySelector('#passwordInput + .label-warning').classList.remove('hidden');
        } else {
            document.querySelector('#passwordInput + .label-warning').classList.add('hidden');
        }

        confirmPasswordInput.addEventListener('blur', checkPasswordsMatch);

        registerCodeInput.addEventListener('input', () => {
            // Remove whitespaces before and after the code value
            registerCodeInput.value = registerCodeInput.value.trim();
            // Debounce the input to avoid too many requests
            if (registerCodeInput.value.length < 1) {
                document.querySelector('#registerCodeInput + .text-danger').classList.add('d-none');
                registerBtn.disabled = false;
                return;
            }
            clearTimeout(debounceTimeout);

            debounceTimeout = setTimeout(() => {
                const registerCode = registerCodeInput.value.trim();
                const errorElement = document.querySelector('#registerCodeInput + .text-danger');

                if (registerCode.length === 0) {
                    errorElement.classList.add('d-none');
                    registerBtn.disabled = false;
                    return;
                }

                fetch('/check-register-code', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ registerCode })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.exists || !data.valid) {
                            console.log(data.message);
                            errorElement.textContent = data.message || 'Invalid code';
                            errorElement.classList.remove('d-none');
                            registerBtn.disabled = true;
                        } else {
                            console.log('Register code is valid');
                            errorElement.classList.add('d-none');
                            registerBtn.disabled = false;
                        }
                    })
                    .catch(err => {
                        console.error('Error checking register code:', err);
                    });

            }, 1000);
        });
    </script>
</body>
</html>
