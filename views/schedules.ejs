<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('general.schedule') %> - <%= t('general.harmony'); %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <!-- Custom CSS -->
</head>

<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="d-sm-flex justify-content-between align-items-center mb-4">
                        <h3 class="text-dark mb-0"><%= t('general.schedule-plural') %></h3>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="card shadow">
                                <div class="card-header py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <p class="text-primary m-0 fw-bold">Active schedules:</p>
                                        <button class="btn btn-sm d-none d-md-inline-block"
                                    data-book-id=""
                                    data-target="#newScheduleModal" data-toggle="modal"
                                    type="button">
                                    <i class="fa fa-plus"></i>
                                </button>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Target date:</th>
                                                <th>Created at:</th>
                                                <th>Status:</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (!activeSchedules || activeSchedules.length === 0) { %>
                                                <tr>
                                                    <td colspan="5" class="text-center">No active schedules.</td>
                                                </tr>
                                            <% } else { %>
                                                <% activeSchedules.forEach(schedule => { %>
                                                    <tr>
                                                        <td><%= schedule.type %></td>
                                                        <td><%= schedule.expiry_date ? schedule.expiry_date.toISOString().split('T')[0] : 'N/A' %></td>
                                                        <td><%= schedule.created_at.toISOString().split('T')[0] %></td>
                                                        <td>
                                                            <% if (schedule.status === 'active') { %>
                                                                <span class="badge rounded-pill bg-success">Active</span>
                                                            <% } else if (schedule.status === 'inactive') { %>
                                                                <span class="badge rounded-pill bg-danger">Inactive</span>
                                                            <% } else if (schedule.status === 'pending') { %>
                                                                <span class="badge rounded-pill bg-warning text-dark">Pending</span>
                                                            <% } %>
                                                        </td>
                                                        <td><i class="fa fa-edit"></i> <i class="fa fa-check"></i> <i class="fa fa-trash"></i></td>
                                                    </tr>
                                                <% }); %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card shadow">
                                <div class="card-header py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <p class="text-primary m-0 fw-bold">Inactive schedules:</p>
                                        <p class="text-primary">See all</p>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Expired at:</th>
                                                <th>Created at:</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (inactiveSchedules.length === 0) { %>
                                                <tr>
                                                    <td colspan="3" class="text-center">No inactive schedules.</td>
                                                </tr>
                                            <% } else { %>
                                                <% inactiveSchedules.forEach(schedule => { %>
                                                    <tr>
                                                        <td><%= schedule.type %></td>
                                                        <td><%= schedule.expiry_date ? schedule.expiry_date.toISOString().split('T')[0] : 'N/A' %></td>
                                                        <td><%= schedule.created_at.toISOString().split('T')[0] %></td>
                                                    </tr>
                                                <% }); %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>
        </div>
        
    </div>

    
    <%- include('partials/schedules/create_schedule') %>

    <!-- Bootstrap JS and dependencies -->
     <script src="/scripts/schedules-script.js"></script>
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
    </html>