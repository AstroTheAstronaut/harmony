<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('general.setup') %></title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
</head>
<body class="bg-gradient-primary">
    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="card shadow-lg w-100" style="max-width: 650px;">
            <div class="card-body text-center">
                <img src="/img/wave.svg" 
                     alt="Harmony Logo" 
                     width="100" 
                     class="mb-3">
                <% if(currentStep === 1) { %>
                <h1 class="h3 mb-3 fw-bold">Welcome to Harmony!</h1>
                <p class="text-muted">
                    Select the language you want to use during the setup process:
                </p>
                <div class="mb-4">
                    <select class="form-select form-select-lg" aria-label="Language selection">
                        <option selected>Select a language</option>
                        <option value="en">English</option>
                        <option value="es">Español</option>
                        <option value="fr">Français</option>
                        <option value="de">Deutsch</option>
                        <option value="it">Italiano</option>
                        <option value="ro">Română</option>
                    </select>
                </div>
                <% } else if(currentStep === 2) { %>
                <h1 class="h3 mb-3 fw-bold">Database Setup</h1>
                <p class="text-muted">Enter your database information:</p>
                <% } %>
                <a href="#" class="btn btn-primary btn-lg w-100 mb-2">Continue</a>
                <a href="#" class="btn btn-link">Need more help?</a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
