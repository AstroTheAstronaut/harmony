    //             if (hiddenContainer.querySelectorAll('input[name="singers"]').length === 0) {
    //                 return; // Stop here, the other listener prevents default
    //             }
    //         }
    //         // Don't submit an empty song search
    //         if (formId === 'addSongToScheduleForm') {
    //             const hiddenUid = document.getElementById('hiddenSongUid');
    //             if (!hiddenUid.value) return; 
