<!-- Song Modal -->
<div class="modal fade" id="addSongToScheduleModal" tabindex="-1" aria-labelledby="addSongToScheduleModal"
        aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSongToScheduleModal">Add a song</h5>
                <button type="button" class="btn-close close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Search for a song</p>
                <form class="d-none d-sm-inline-block me-auto ms-md-3 my-2 my-md-0 mw-100 navbar-search position-relative" action="/search" method="GET">
                    <div class="input-group">
                        <input class="bg-light form-control border-0 small search-input" type="text" placeholder="<%= t('general.search_lyrics') %>" id="searchQuery" name="query" autocomplete="off" required>
                        <button class="btn btn-primary py-0" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    
                    <div class="search-results-addsong-dropdown shadow-sm border rounded mt-1 position-absolute bg-white w-100" style="z-index: 1000; display: none; top: 100%;">
                        <div class="list-group list-group-flush rounded">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <form action="<%= typeof schedule !== 'undefined' && schedule ? `/schedule-edit/${schedule.schedule_uid}/add-content` : '#' %>" method="POST" class="d-inline" id="addSongToScheduleForm">
                    <input name="title" type="hidden" id="hiddenSongTitle">
                    <input name="type" type="hidden" value="song">
                    <input name="song_uid" type="hidden" id="hiddenSongUid">
                    <button type="submit" class="btn btn-secondary" id="addSongToScheduleButton" disabled>Add song to schedule</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Intro Modal -->

<div class="modal fade" id="addIntroToScheduleModal" tabindex="-1" aria-labelledby="addIntroToScheduleModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="<%= typeof schedule !== 'undefined' && schedule ? `/schedule-edit/${schedule.schedule_uid}/add-content` : '#' %>" method="POST" id="addIntroToScheduleForm">
                
                <div class="modal-header">
                    <h5 class="modal-title">Add an introduction</h5>
                    <button type="button" class="btn-close close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p>Enter a speaker's name</p>
                    <input class="bg-light form-control border-0 small" name="speaker" id="speakerNameInput" placeholder="Enter your speaker's name" required>
                </div>

                <div class="modal-footer">
                    <input name="type" type="hidden" value="intro">
                    <button type="submit" class="btn btn-secondary" id="addIntroToScheduleButton">Add intro to schedule</button>
                </div>

            </form>
        </div>
    </div>
</div>

