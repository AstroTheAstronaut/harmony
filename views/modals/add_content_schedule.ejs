<!-- Solo Song Modal -->

<div class="modal fade" id="addSoloSongToScheduleModal" tabindex="-1" aria-labelledby="addSoloSongToScheduleModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="<%= typeof schedule !== 'undefined' && schedule ? `/schedule-edit/${schedule.schedule_uid}/add-content` : '#' %>" method="POST" id="addSoloSongToScheduleForm">
                
                <div class="modal-header">
                    <h5 class="modal-title">Add solo song</h5>
                    <button type="button" class="btn-close close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p>Enter a singer's name</p>
                    <div class="d-flex flex-column mb-3">
                        <input class="bg-light form-control border-0 mb-3 small" id="soloSongTitle" placeholder="Enter title (optional)">
                        <input class="bg-light form-control border-0 mb-3 small" id="singerNameInput" placeholder="Enter name...">
                        <button class="btn btn-primary" type="button" id="addSingerToListBtn">Add to list</button>
                    </div>

                    <div id="singersListDisplay" class="mb-3">
                        <h6>Current Singers:</h6>
                        <ul class="list-group" id="singersUl">
                            <li class="list-group-item text-muted small">No singers added yet</li>
                        </ul>
                    </div>

                    <div id="hiddenSingersInputs"></div>
                    <input type="hidden" name="title" id="hiddenSoloSongTitle">
                </div>

                <div class="modal-footer">
                    <input name="type" type="hidden" value="solo_song">
                    <button type="submit" class="btn btn-secondary" id="addSingerToScheduleButton">Add solo song to schedule</button>
                </div>

            </form>
        </div>
    </div>
</div>
<script>
    // 1. Get the main modal
    const addSongModal = document.getElementById('addSongToScheduleModal');
    
    // 2. Fix the naming: use addSongModal instead of modal
    const searchInput = addSongModal ? addSongModal.querySelector('.search-input') : null;
    const hiddenSongUid = document.getElementById('hiddenSongUid');
    const hiddenSongTitle = document.getElementById('hiddenSongTitle');
    const addSongButton = document.getElementById('addSongToScheduleButton');
    const addSongForm = document.getElementById('addSongToScheduleForm');

    // 3. Select dropdown elements once, carefully
    const dropdown = addSongModal ? addSongModal.querySelector('.search-results-addsong-dropdown') : null;
    const listGroup = dropdown ? dropdown.querySelector('.list-group') : null;

    if (searchInput && dropdown && listGroup) {
        let debounceTimer;

        searchInput.addEventListener('input', function() {
            const query = this.value.trim();
            clearTimeout(debounceTimer);

            if (query.length === 0) {
                dropdown.style.display = 'none';
                listGroup.innerHTML = '';
                hiddenSongUid.value = '';
                hiddenSongTitle.value = '';
                addSongButton.disabled = true;
                return;
            }

            debounceTimer = setTimeout(async () => {
                try {
                    const response = await fetch(`/autocomplete?q=${encodeURIComponent(query)}`);
                    const results = await response.json();

                    listGroup.innerHTML = '';

                    if (results.length > 0) {
                        results.forEach(song => {
                            listGroup.innerHTML += `
                                <button type="button" data-song-uid="${song.song_uid}" data-song-title="${song.title}" class="list-group-item list-group-item-action py-2 text-start border-0">
                                    <div class="fw-bold text-dark mb-0">${song.title}</div>
                                    <small class="text-muted">Song Lyrics</small>
                                </button>
                            `;
                        });
                    } else {
                        listGroup.innerHTML = `<div class="list-group-item text-center text-muted small py-2">No results found</div>`;
                    }

                    dropdown.style.display = 'block';
                } catch (error) {
                    console.error("Autocomplete error:", error);
                }
            }, 300);
        });

        // Event Delegation for clicking results
        // listGroup.addEventListener('click', function(event) {
        //     const option = event.target.closest('[data-song-uid]');
        //     if (!option) return;

        //     hiddenSongTitle.value = option.getAttribute('data-song-title');
        //     hiddenSongUid.value = option.getAttribute('data-song-uid');
            
        //     searchInput.value = option.getAttribute('data-song-title') || '';
        //     addSongButton.disabled = false;
        //     dropdown.style.display = 'none';
        // });
        listGroup.addEventListener('click', function(event) {
            const option = event.target.closest('[data-song-uid]');
            if (!option) return;

            const selectedUid = option.getAttribute('data-song-uid');
            const selectedTitle = option.getAttribute('data-song-title');

            // Use the specific references we defined at the top
            hiddenSongUid.value = selectedUid;
            hiddenSongTitle.value = selectedTitle;
            
            // EXPLICITLY set the type here to be safe
            const typeInput = addSongForm.querySelector('input[name="type"]');
            if (typeInput) {
                typeInput.value = 'song';
            }

            searchInput.value = selectedTitle || '';
            addSongButton.disabled = false;
            dropdown.style.display = 'none';
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {
            if (!addSongModal.contains(event.target)) {
                dropdown.style.display = 'none';
            }
        });

        if (addSongForm) {
            addSongForm.addEventListener('submit', function(event) {
                if (!hiddenSongUid.value) {
                    event.preventDefault();
                }
            });
        }
    }

    // --- Solo Song Modal Logic ---
    const soloSongModal = document.getElementById('addSoloSongToScheduleModal');

    if (soloSongModal) {
        const addSingerBtn = document.getElementById('addSingerToListBtn');
        const singerInput = document.getElementById('singerNameInput');
        const soloSongTitleInput = document.getElementById('soloSongTitle');
        
        const ul = document.getElementById('singersUl');
        const hiddenContainer = document.getElementById('hiddenSingersInputs');
        const hiddenTitle = document.getElementById('hiddenSoloSongTitle');
        const submitBtn = document.getElementById('addSingerToScheduleButton');
        const soloForm = document.getElementById('addSoloSongToScheduleForm');

        // 1. Logic to add a singer to the list
        addSingerBtn.addEventListener('click', function() {
            const name = singerInput.value.trim();
            
            if (name === "") return;

            // Remove placeholder if it exists
            if (ul.querySelector('.text-muted')) ul.innerHTML = '';

            // Add to visible list
            const li = document.createElement('li');
            li.className = 'list-group-item py-2';
            li.textContent = name;
            ul.appendChild(li);

            // Add hidden input for the backend
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'singers'; 
            hiddenInput.value = name;
            hiddenContainer.appendChild(hiddenInput);

            // Cleanup and enable submit
            singerInput.value = '';
            submitBtn.disabled = false;
        });

        // 2. Sync title and validate before form submission
        soloForm.addEventListener('submit', function(e) {
            // Grab the title from the visible input and put it in the hidden one
            hiddenTitle.value = soloSongTitleInput.value.trim();

            // Safety check: ensure at least one singer exists
            const singersCount = hiddenContainer.querySelectorAll('input[name="singers"]').length;
            if (singersCount === 0) {
                e.preventDefault();
                alert("Please add at least one singer before submitting.");
            }
        });
    }

