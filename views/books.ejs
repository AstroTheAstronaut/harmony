<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('general.books') %> - <%= t('general.harmony'); %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <!-- Custom CSS -->
    <style>
        .text-smaller-responsive {
            font-size: 0.8rem;
        }
    </style>
</head>

<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="d-sm-flex justify-content-between align-items-center mb-4">
                        <h3 class="text-dark mb-0"><%= t('general.books') %></h3>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 mb-4">
                            <%- include('partials/books', { userRole: userRole }) %>
                        </div>
                        <% if(hasPermission('create_book') && hasPermission('upload_book')) { %>
                        <div class="col">
                            <%- include('partials/create_book') %>
                        </div>                 
                    </div>
                    <div class="row-auto">
                        <%- include('partials/upload_book') %>
                    </div>
                    <% } else {} %>
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>
        </div>
        
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js"></script>
    <script>
        // Add event listeners to filter songs by book
        document.querySelectorAll('.list-group-item').forEach(item => {
            item.addEventListener('click', function () {
                const bookId = this.querySelector('button[data-book-id]').getAttribute('data-book-id');
                filterSongsByBook(bookId);
            });
        });

        function filterSongsByBook(bookId) {
            const songsList = document.getElementById('songs-list');
            songsList.querySelectorAll('.list-group-item').forEach(songItem => {
                const songBookId = songItem.getAttribute('data-book-id');
                if (bookId === '' || songBookId === bookId) {
                    songItem.style.display = '';
                } else {
                    songItem.style.display = 'none';
                }
            });
        }

        $(document).ready(function () {
            $('#deleteBookModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Button that triggered the modal
                var book_uuid = button.data('book-id'); // Fetch the specific book ID

                // Display the UUID in the modal
                $('#bookUUIDDisplay').text(book_uuid);

                // Clear any previous input and disable the buttons
                $('#confirmBookUUID').val('');
                $('#deleteOnlyForm button').prop('disabled', true);
                $('#deleteWithSongsForm button').prop('disabled', true);

                // Listen for changes in the confirmation input
                $('#confirmBookUUID').on('input', function () {
                    var inputUUID = $(this).val().trim();
                    var isMatch = inputUUID === book_uuid;

                    // Enable or disable buttons based on input match
                    $('#deleteOnlyForm button').prop('disabled', !isMatch);
                    $('#deleteWithSongsForm button').prop('disabled', !isMatch);

                    // Set hidden input values if there's a match
                    if (isMatch) {
                        $('#hiddenDeleteOnlyUUID').val(book_uuid);
                        $('#hiddenDeleteWithSongsUUID').val(book_uuid);
                    } else {
                        $('#hiddenDeleteOnlyUUID').val('');
                        $('#hiddenDeleteWithSongsUUID').val('');
                    }
                });
            });
        });

        document.getElementById('bookFile').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const zip = new JSZip();

                    // Load the ZIP file
                    zip.loadAsync(e.target.result).then(function(zip) {
                        // Check if 'book.json' exists in the ZIP file
                        const bookJsonFile = zip.file('book.json');
                        if (!bookJsonFile) {
                            throw new Error('book.json file is missing in the ZIP archive.');
                        }
                    
                    // Read 'book.json'
                    return bookJsonFile.async('string');
                    }).then(function(bookJsonContent) {
                        // Parse 'book.json' to extract book name and UUID
                        let bookData;
                        try {
                            bookData = JSON.parse(bookJsonContent);
                        } catch (e) {
                            throw new Error('Error parsing book.json: ' + e.message);
                        }

                    const bookName = bookData.name || 'Unknown';
                    const bookUID = bookData.book_uuid || 'Unknown';

                    // Count '.lyric' files in the 'lyrics' folder
                    const lyricFiles = [];
                    Object.keys(zip.files).forEach(function(filename) {
                        if (filename.startsWith('lyrics/') && filename.endsWith('.lyric')) {
                            lyricFiles.push(filename);
                        }
                    });
                    const songCount = lyricFiles.length;

                    // Ensure the preview section elements exist
                    const bookNameElement = document.getElementById('bookNamePreview');
                    const bookUIDElement = document.getElementById('bookUIDPreview');
                    const songCountElement = document.getElementById('songCountPreview');
                    const filePreviewElement = document.getElementById('filePreview');

                    if (bookNameElement && bookUIDElement && songCountElement && filePreviewElement) {
                        // Update the preview section with book name, UID, and song count
                        bookNameElement.textContent = `${bookName}`;
                        bookUIDElement.textContent = `${bookUID}`;
                        songCountElement.textContent = `${songCount}`;
                        filePreviewElement.style.display = 'block';
                    } else {
                        console.error('One or more preview section elements are missing.');
                    }
                })
                .catch(function(error) {
                    console.error('Error reading ZIP file:', error);
                    alert('Failed to read the ZIP file. Please ensure it contains a valid book.json file and .lyric files.');
                });
        };

        // Read the file as ArrayBuffer (required for ZIP files)
        reader.readAsArrayBuffer(file);
            } else {
                const filePreviewElement = document.getElementById('filePreview');
                if (filePreviewElement) {
                    filePreviewElement.style.display = 'none';
                }
            }
        });
    </script>

    <div class="fade modal" role="dialog" aria-hidden="true" aria-labelledby="deleteBookModalLabel" id="deleteBookModal"
        tabindex="-1">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteBookModalLabel">Confirm Deletion</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this book?</p>
                    <p>This action has two options:</p>
                    <ul>
                        <li><strong>Delete Only Book:</strong> This will remove the book entry but keep associated
                            songs.</li>
                        <li><strong>Delete Book with Songs:</strong> This will remove the book entry along with all
                            associated songs.</li>
                    </ul>
                    <p>To continue, please type the Book UID (Unique Identifier) into the textbox below:</p>
                    <div class="card uuid-card">
                        <div class="card-body text-center">
                            <strong>Book UID: </strong><strong class="uuid-text" id="bookUUIDDisplay"></strong>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="confirmBookUUID">Type the Book UID to confirm:</label>
                        <input type="text" class="form-control" id="confirmBookUUID" required>
                    </div>
                </div>

                <div class="modal-footer">
                    <form action="/delete-book" method="POST" class="d-inline" id="deleteOnlyForm">
                        <input name="book_uuid" type="hidden" id="hiddenDeleteOnlyUUID">
                        <button type="submit" class="btn btn-secondary" disabled>Delete Only Book</button>
                    </form>
                    <form action="/delete-book-with-songs" method="POST" class="d-inline" id="deleteWithSongsForm">
                        <input name="book_uuid" type="hidden" id="hiddenDeleteWithSongsUUID">
                        <button type="submit" class="btn btn-danger" disabled>Delete Book with Songs</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>

</html>