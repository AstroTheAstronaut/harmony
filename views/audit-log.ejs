<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('general.activity_log') %> - <%= t('general.harmony'); %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
</head>
<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="d-sm-flex justify-content-between align-items-center mb-4">
                        <h3 class="text-dark mb-0"><%= t('general.activity_log') %></h3>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 mb-4">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary"><%= t('audit_log.song_requests') %></h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table">
                                            <thead>
                                                <th><%= t('general.no') %></th>
                                                <th><%= t('song.title') %></th>
                                                <th><%= t('book.book') %></th>
                                                <th><%= t('audit_log.requested_by') %></th>
                                                <th><%= t('audit_log.requested_at') %></th>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td id="noTd">
                                                        1
                                                    </td>
                                                    <td id="titleTd">
                                                        <a href="#" class="text-decoration-none text-dark">
                                                            Song Title 1
                                                        </a>
                                                    </td>
                                                    <td id="bookTd">
                                                        <a href="#" class="text-decoration-none text-dark">
                                                            Book Title 1
                                                        </a>
                                                    </td>
                                                    <td id="requestedBy">
                                                        <a href="#" class="text-decoration-none text-dark">
                                                            John Doe
                                                        </a>
                                                    </td>
                                                    <td id="requestedAt">
                                                        2023-10-01 12:00:00
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <a href="#" class="text-decoration-none text-primary">
                                            <%= t('audit_log.see_all_past_requests') %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary"><%= t('audit_log.user_log_in') %></h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table">
                                            <thead>
                                                <th><%= t('general.no') %></th>
                                                <th><%= t('audit_log.user') %></th>
                                                <th><%= t('audit_log.ip_address') %></th>
                                                <th><%= t('audit_log.logged_in_at') %></th>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td id="noTd">
                                                        1
                                                    </td>
                                                    <td id="userTd">
                                                        <a href="#" class="text-decoration-none text-dark">
                                                            John Doe
                                                        </a>
                                                    </td>
                                                    <td id="ipAddressTd">
                                                        <a class="text-decoration-none text-dark" href="https://www.iplocation.net/find-ip-address">
                                                            192.168.1.1
                                                        </a>
                                                    </td>
                                                    <td id="loggedInAtTd">
                                                        2023-10-01 12:00:00
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <a href="#" class="text-decoration-none text-primary">
                                            <%= t('audit_log.see_all_past_events') %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>                 
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary"><%= t('audit_log.user_activity') %></h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table">
                                            <thead>
                                                <th><%= t('general.no') %></th>
                                                <th><%= t('audit_log.user') %></th>
                                                <th><%= t('audit_log.activity') %></th>
                                                <th><%= t('audit_log.activity_at') %></th>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td id="noTd">
                                                        1
                                                    </td>
                                                    <td id="userTd">
                                                        <a href="#" class="text-decoration-none text-dark">
                                                            John Doe
                                                        </a>
                                                    </td>
                                                    <td id="activityTd">
                                                        <a href="#" class="text-decoration-none text-dark">
                                                            Updated profile information
                                                        </a>
                                                    </td>
                                                    <td id="activityAtTd">
                                                        2023-10-01 12:00:00
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <a href="#" class="text-decoration-none text-primary">
                                            <%= t('audit_log.see_all_past_activity') %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary"><%= t('audit_log.system_events') %></h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responive">
                                        <table class="table">
                                            <thead>
                                                <th><%= t('general.no') %></th>
                                                <th><%= t('audit_log.event') %></th>
                                                <th><%= t('audit_log.event_description') %></th>
                                                <th><%= t('audit_log.event_at') %></th>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td id="noTd">
                                                        1
                                                    </td>
                                                    <td id="eventTd">
                                                        <a href="#" class="text-decoration-none text-dark">
                                                            System Update
                                                        </a>
                                                    </td>
                                                    <td id="eventDescriptionTd">
                                                        <a href="#" class="text-decoration-none text-dark">
                                                            Updated to version 1.2.3
                                                        </a>
                                                    </td>
                                                    <td id="eventAtTd">
                                                        2023-10-01 12:00:00
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <a href="#" class="text-decoration-none text-primary">
                                            <%= t('audit_log.see_all_past_events') %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row-auto">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary"><%= t('audit_log.stats') %></h6>
                            </div>
                            <div class="card-body">
                                <div>
                                    <canvas id="myChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>
        </div>
        
    </div>
    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
  const ctx = document.getElementById('myChart');

  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Red', 'Blue', 'Yellow', 'Green', 'Purple', 'Orange'],
      datasets: [{
        label: '# of Votes',
        data: [12, 19, 3, 5, 2, 3],
        borderWidth: 1
      }]
    },
    options: {
      scales: {
        y: {
          beginAtZero: true
        }
      }
    }
  });
</script>
</body>
</html>