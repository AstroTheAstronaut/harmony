<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>
        <% if (song.book_song_number) { %>
            <% if (song.book_details && song.book_details.bo_name) { %>
                <%= song.book_song_number %>. <%= song.title %> - <%= song.book_details.bo_name %>
            <% } else { %>
                <%= song.book_song_number %>. <%= song.title %>
            <% } %>
        <% } else { %>
            <%= song.title %>
        <% } %>

    </title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <style>
        pre{
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        pre::-webkit-scrollbar {
            display: none;
        }

        .badge {
            font-size: 0.8rem;
        }
    </style>
</head>
<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <div class="row align-items-center">
                                <!-- Text content column -->
                                <div class="col-md-8">
                                  <form id="editSongForm" action="/edit-song/<%= song.song_uid %>/inline" method="POST">
                                    <div id="songTitleBlock">
                                      <div id="titleView">
                                        <h2 class="text-dark fw-bold m-0">
                                          <% if(song.book_song_number) { %>
                                            <%= song.book_song_number %>. <%= song.title %>
                                          <% } else { %>
                                            <%= song.title %>
                                          <% } %>
                                        </h2>
                                      </div>
                                      <div id="titleEdit" class="d-none">
                                        <input name="title" type="text" class="form-control mb-2" value="<%= song.title %>">
                                      </div>
                                    </div>
                                    <div id="artistBlock">
                                      <div id="artistView">
                                        <% if(song.artist !== "NaN") { %>
                                          <h5 class="mt-2"><%= t('song.artist') %>: <%= song.artist %></h5>
                                        <% } %>
                                      </div>
                                      <div id="artistEdit" class="d-none">
                                        <label for="artist"><%= t('song.artist') %>:</label>
                                        <input name="artist" type="text" class="form-control mb-2" value="<%= song.artist %>">
                                      </div>
                                    </div>

                                  </form>
                                    <h2 id="song-title" class="text-dark fw-bold m-0">
                                        <% if(song.book_song_number) { %>
                                            <%= song.book_song_number %>. <%= song.title %>
                                        <% } else { %>
                                            <%= song.title %>
                                        <% } %>
                                    </h2>
                                    <% if(song.chord!="NaN") { %>
                                        <h4 class="mt-2"><%= t('song.chord') %>: <%= song.chord %></h4>
                                    <% } %>
                                    <% if(song.artist!="NaN") { %>
                                        <h5 id="song-artist" class="mt-2"><%= t('song.artist') %>: <%= song.artist %></h5>
                                    <% } %>
                                    <% if(song.scripture!="NaN") { %>
                                        <h5 id="song-scripture" class="mt-2"><%= t('song.scripture') %>: <%= song.scripture %></h5>
                                    <% } %>
                                    <% if (song.book_details && song.book_details.bo_name) { %>
                                        <h5 id="song-book-name" class="mt-2"><%= song.book_details.bo_name %></h5>
                                    <% } else { %>
                                        <h5 id="song-book-name" class="mt-2"><%= t('book.no_book') %></h5>
                                    <% } %>
                                    <h5 id="song-tags" class="mt-2">
                                    <% if(song.tags && song.tags.length > 0) { %>
                                        <% for (let i = 0; i < song.tags.length; i++) { %>
                                            <span class="badge rounded-pill bg-primary"><%= song.tags[i] %></span>
                                        <% } %>
                                    <% } %>
                                </div>
                                <!-- Buttons column -->
                                <div class="col-md-4 d-flex justify-content-end d-none d-md-flex">
                                    <!-- Desktop buttons -->
                                    <a href="/song/<%= song.song_uid %>/public" id="share-button" class="btn btn-sm ms-2 share-button"
                                        data-song-title="<% if (song.book_song_number) { %>
                                                        <% if (song.book_details && song.book_details.bo_name) { %>
                                                            <%= song.book_song_number %>. <%= song.title %> - <%= song.book_details.bo_name %>
                                                        <% } else { %>
                                                            <%= song.book_song_number %>. <%= song.title %>
                                                        <% } %>
                                                    <% } else { %>
                                                        <%= song.title %>
                                                    <% } %>"
                                    >
                                         <i class="fa-regular fa-share-from-square"></i>
                                    </a>
                                    <a id="copy-button" class="btn btn-sm ms-2 copy-clipboard-button" data-bs-toggle="tooltip" title="<%= t('general.copy') %>">
                                        <i class="fa-regular fa-copy"></i>
                                    </a>
                                    <% if(userRole === 'Viewer' || userRole === 'Moderator') {} else { %>
                                    <button id="toggleEditButton" class="btn btn-primary btn-sm ms-2" onclick="toggleEditMode()">Edit song</button>
                                    <form action="/request-song" method="POST" class="mb-0 ms-2">
                                        <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                        <button type="submit" class="btn btn-warning btn-sm"><%= t('general.request') %></button>
                                    </form>
                                    <form action="/remove-song" method="POST" class="d-inline ms-2">
                                        <input type="hidden" name="redirectTo" value="<%= decodeURIComponent (requestURL) %>">
                                        <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                        <button type="submit" class="btn btn-danger btn-sm"><%= t('general.remove') %></button>
                                    </form>
                                    <% } %>
                                </div>
                            </div>
                            <!-- Mobile buttons-->
                            <div class="d-md-none mt-3 d-flex justify-content-end">
                                <!-- Share button -->
                                <a href="/song/<%= song.song_uid %>/public" id="share-button-mobile" class="btn btn-sm ms-2 share-button"
                                    data-song-title="<% if (song.book_song_number) { %>
    <% if (song.book_details && song.book_details.bo_name) { %>
        <%= song.book_song_number %>. <%= song.title %> - <%= song.book_details.bo_name %>
    <% } else { %>
        <%= song.book_song_number %>. <%= song.title %>
    <% } %>
<% } else { %>
    <%= song.title %>
<% } %>"
>
                                     <i class="fa-regular fa-share-from-square"></i>
                                 </a>
                                <a id="copy-button-mobile" class="btn btn-sm ms-2 copy-clipboard-button" data-bs-toggle="tooltip" title="<%= t('general.copy') %>">
                                    <i class="fa-regular fa-copy"></i>
                                </a>
                            </div>
                            <% if(userRole === 'Viewer' || userRole === 'Moderator') {} else { %>
                            <!-- Mobile admin/mod buttons -->
                            <div class="d-md-none mt-3">
                                <form action="/request-song" method="POST" class="mb-2">
                                    <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                    <button type="submit" class="btn btn-warning btn-sm w-100"><%= t('general.request') %></button>
                                </form>
                                <a href="/edit-song/<%= song.song_uid %>" class="btn btn-success btn-sm w-100 mb-2 d-block"><%= t('messages.edit_song') %></a>
                                <form action="/remove-song" method="POST">
                                    <input type="hidden" name="redirectTo" value="<%= decodeURIComponent (requestURL) %>">
                                    <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                    <button type="submit" class="btn btn-danger btn-sm w-100"><%= t('general.remove') %></button>
                                </form>
                            </div>
                            <% } %>
                        </div>
                        <div class="card-body">
                            <ul class="list-group">
                                <% song.parts.forEach(part => { %>
                                    <li class="list-group-item lyrics-text">
                                        <strong>
                                            <% if (part.part_type === "CHORUS" || part.part_type === "Chorus") { %>
                                                <%= t('song_parts.chorus') %>:
                                            <% } else if (part.part_type === "VERSE" || part.part_type === "Verse") { %>
                                                <%= t('song_parts.verse') %>:
                                            <% } else if (part.part_type === "BRIDGE" || part.part_type === "BRIDGE") { %>
                                                <%= t('song_parts.bridge') %>:
                                            <% } else if (part.part_type === "CODA" || part.part_type === "Coda") { %>
                                                <%= t('song_parts.coda') %>:
                                            <% } else if (part.part_type === "OUTRO" || part.part_type === "Outro") { %>
                                                <%= t('song_parts.outro') %>:
                                            <% } else if (part.part_type === 'INTRO' || part.part_type === "Intro") { %>
                                                <%= t('song_parts.intro') %>:
                                            <% } else { %>
                                                <%= t('song_parts.unknown') %>:
                                            <% } %>
                                        </strong>
                                        <pre id="part-<%= part.id %>" class="part-text"><%= part.lyrics %></pre>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>                        
                    </div>
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>
    </div>
    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script>
        function handleShare(event, buttonId) {
            event.preventDefault();  // Prevent the default action (navigation)

            const shareUrl = window.location.origin + document.getElementById(buttonId).getAttribute('href');  // Get the link to share
            const songTitle = document.getElementById(buttonId).getAttribute('data-song-title');  // Get the song title from the data attribute
            const songText = `${songTitle}\n`;

            // Check if the Web Share API is supported
            if (navigator.share) {
                navigator.share({
                    title: songTitle,
                    text: songText,
                    url: shareUrl
                }).then(() => {
                    console.log('Successfully shared');
                }).catch((error) => {
                    console.error('Error sharing', error);
                });
            } else {
                // Fallback to copying URL to clipboard if Web Share API isn't supported
                navigator.clipboard.writeText(shareUrl).then(() => {
                    alert('Link copied to clipboard!');
                }).catch((error) => {
                    console.error('Error copying text', error);
                });
            }
        }

        document.querySelectorAll('.share-button').forEach(button => {
            button.addEventListener('click', function(event) {
                handleShare(event, button.id);
            });
        });

        function copyLyricsToClipboard() {
            const songParts = document.querySelectorAll('.lyrics-text');
            let formattedLyrics = '';
            const songTitle = document.getElementById('song-title')?.innerText.trim() || '';
            const songBookName = document.getElementById('song-book-name')?.innerText.trim() || '';
            const songArtist = document.getElementById('song-artist')?.innerText.trim() || '';
            // Add song info to the copied text
            if (songTitle) {
                formattedLyrics += `${songTitle}\n`;
                if (songArtist) {
                    formattedLyrics += `${songArtist}\n`;
                }
                if (songBookName) {
                    formattedLyrics += `- ${songBookName} -\n`;
                }
                formattedLyrics += '\n';
            }
            // Add each part of the song to the copied text
            songParts.forEach(item=>{
                const partLabel = item.querySelector('strong').innerText.trim();
                const partLyrics = item.querySelector('.part-text').innerText.trim();
                formattedLyrics += `${partLabel}\n${partLyrics}\n\n`;
            });

            navigator.clipboard.writeText(formattedLyrics).then(() => {
                const copyButtons = document.querySelectorAll('.copy-clipboard-button');
                copyButtons.forEach(button => {
                    button.innerHTML = '<i class="fa-solid fa-heart"></i>';
                    button.classList.add('animate-icon');
                    setTimeout(() => {
                        button.innerHTML = '<i class="fa-regular fa-copy"></i>';
                        button.classList.remove('animate-icon');
                    }, 1000);
                });
            }).catch((error) => {
                console.error('Error copying text', error);
            });
        }

        document.querySelectorAll('.copy-clipboard-button').forEach(button => {
            button.addEventListener('click', function() {
                copyLyricsToClipboard();
            });
        });
    </script>
</body>
</html>

