<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= schedule.name %> - Viewing Schedule</title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <style>
        /* ================= CARDS ================= */
        .content-cards {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .content-card {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            background: white;
            transition: all 0.2s ease;
            cursor: grab;
        }

        .content-card:hover {
            box-shadow: 0 6px 14px rgba(0,0,0,0.08);
            transform: translateY(-2px);
            border-color: #0d6efd;
        }

        .content-card:active {
            cursor: grabbing;
            transform: scale(0.98);
        }
    </style>
</head>

<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
            <div class="d-flex flex-column" id="content-wrapper" style="justify-content: space-between;">
                <div id="content">
                    <%- include('partials/navbar', { userRole: userRole }) %>
                        <div class="container-fluid">
                            <div class="card shadow">
                                <div class="card-header py-3">
                                    <div class="row">
                                        <div class="col-md-10">
                                            <h2 class="text-dark fw-bold m-0" id="schedule-name">
                                                <%= schedule.name %>
                                            </h2>
                                            <% if(schedule.description) { %>
                                                <h3 class="mt-2"><%= schedule.description %></h3>
                                            <% } else {}%>
                                            <% if(schedule.creator_fullname) { %>
                                                <h5 class="mt-2">by <%= schedule.creator_fullname %></h5>
                                            <% } else {}%>
                                            <% if(schedule.target_church) { %>
                                                <h5 class="mt-2">For: <%= schedule.target_church %></h5>
                                            <% } else {}%>
                                            <h5 class="mt-2">Expiry date: <%= schedule.expiry_date ? schedule.expiry_date.toISOString().split('T')[0] : '' %></h5>
                                            <h5 class="mt-2">Type: <%= schedule.type %></h5>
                                            
                                            <% if(schedule.bible_passage) { %>
                                                <h5 class="mt-2">Bible: <%= schedule.bible_passage %></h5>
                                            <% } else {}%>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="d-md-flex justify-content-end flex-wrap gap-2">
                                                <% if (hasPermission('edit_schedule')) { %>
                                                    <a href="/schedule-edit/<%= schedule.schedule_uid %>" class="btn btn-warning btn-sm">Edit</a>
                                                    <button class="btn btn-danger btn-sm" data-schedule-id="<%= schedule.schedule_uid %>" data-schedule-name="<%= schedule.name %>" data-target="#deleteScheduleModal" data-toggle="modal">Delete</button>
                                                <% } else {}%>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                        <div class="content-cards" id="editorCardsContainer">
                                            <% let songCounterEditor = 1; %>
                                        <% (schedule.content || []).forEach((item) => { %>
                                            
                                            <% if (item && item.type === 'song') { %>
                                                <div class="content-card d-flex justify-content-between align-items-center p-2 p-md-3" data-index="<%= item.position %>" data-type="song">
                                                    <div class="d-flex align-items-center flex-grow-1 me-2 overflow-hidden">
                                                        <span class="badge bg-primary px-2 me-3 fs-6 editor-number"><%= songCounterEditor %>.</span>
                                                        <% songCounterEditor++ %>
                                                        <div class="d-flex flex-column text-wrap">
                                                            <small class="mb-0 fw-bold text-primary text-uppercase" style="font-size: 0.75rem;">Song</small>
                                                            <span class="fw-bold text-dark fs-6 lh-sm mt-1"><%= item.title %></span>
                                                        </div>
                                                    </div>
                                                </div>

                                            <% } else if (item && item.type === 'intro') { %>
                                                <div class="content-card ms-md-4 d-flex justify-content-between align-items-center p-2 p-md-3" data-index="<%= item.position %>" data-type="intro">
                                                    <div class="d-flex align-items-center flex-grow-1 me-2 overflow-hidden">
                                                        <div class="d-flex flex-column text-wrap">
                                                            <small class="mb-0 fw-bold text-primary text-uppercase" style="font-size: 0.75rem;">Introduction</small>
                                                            <span class="fw-bold text-dark fs-6 lh-sm mt-1"><%= item.speaker %></span>
                                                        </div>
                                                    </div>
                                                </div>

                                            <% } else if (item && item.type === 'poem') { %>
                                                <div class="content-card ms-md-4 d-flex justify-content-between align-items-center p-2 p-md-3" data-index="<%= item.position %>" data-type="poem">
                                                    <div class="d-flex align-items-center flex-grow-1 me-2 overflow-hidden">
                                                        <div class="d-flex flex-column text-wrap">
                                                            <small class="mb-0 fw-bold text-primary text-uppercase" style="font-size: 0.75rem;">Poem</small>
                                                            <span class="fw-bold text-dark fs-6 lh-sm mt-1"><%= item.speaker %></span>
                                                        </div>
                                                    </div>
                                                </div>

                                            <% } else if (item && item.type === 'verses') { %>
                                                <div class="content-card ms-md-4 d-flex justify-content-between align-items-center p-2 p-md-3" data-index="<%= item.position %>" data-type="verses">
                                                    <div class="d-flex align-items-center flex-grow-1 me-2 overflow-hidden">
                                                        <div class="d-flex flex-column text-wrap">
                                                            <small class="mb-0 fw-bold text-primary text-uppercase" style="font-size: 0.75rem;">Verses</small>
                                                            <span class="fw-bold text-dark fs-6 lh-sm mt-1"><%= item.speaker %> <%= item.verses ? `- ${item.verses}` : '' %></span>
                                                        </div>
                                                    </div>
                                                </div>

                                            <% } else if (item && item.type === 'solo_song') { %>
                                                <div class="content-card ms-md-4 d-flex justify-content-between align-items-center p-2 p-md-3" data-index="<%= item.position %>" data-type="solo_song">
                                                    <div class="d-flex align-items-center flex-grow-1 me-2 overflow-hidden">
                                                        <div class="d-flex flex-column text-wrap">
                                                            <small class="mb-0 fw-bold text-primary text-uppercase" style="font-size: 0.75rem;">Solo Song</small>
                                                            <span class="fw-bold text-dark fs-6 lh-sm mt-1"><%= item.title || 'Untitled Solo' %></span>
                                                            <small class="text-muted mt-1">Singers: <%= Array.isArray(item.singers) ? item.singers.join(', ') : item.singers %></small>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% } %>
                                        <% }) %>
                                        </div>
                                </div>
                            </div>
                        </div>
                </div>
            <%- include('modals/delete_schedule_modal') %>
            <%- include('partials/footer') %>
    </div>
    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script>
        $(document).ready(function() {
            let currentScheduleName = "";
            let currentScheduleUid = "";
            let countdownInterval;

            // STEP 1: Modal Opens
            $('#deleteScheduleModal').on('show.bs.modal', function(event) {
                const button = $(event.relatedTarget);
                currentScheduleName = button.data('schedule-name');
                currentScheduleUid = button.data('schedule-id');

                $('#step1Name').text(currentScheduleName);
                $('#confirmNameInput').val('');
                $('#toStep2Btn').prop('disabled', true);
            });

            // Check if name matches
            $('#confirmNameInput').on('input', function() {
                const match = $(this).val() === currentScheduleName;
                $('#toStep2Btn').prop('disabled', !match).toggleClass('btn-primary', match).toggleClass('btn-secondary', !match);
            });

            // Move to Step 2
            $('#toStep2Btn').on('click', function() {
                $('#deleteScheduleModal').modal('hide');
                $('#deleteScheduleConfirmModal').modal('show');
            });

            // STEP 2: The Countdown
            $('#deleteScheduleConfirmModal').on('show.bs.modal', function() {
                $('#step2Name').text(currentScheduleName);
                $('#finalDeleteUUID').val(currentScheduleUid);
                
                let timeLeft = 5;
                $('#finalDeleteBtn').prop('disabled', true).text(`Delete Schedule (${timeLeft}s)`);
                
                clearInterval(countdownInterval); // Clear any old ones
                countdownInterval = setInterval(() => {
                    timeLeft--;
                    if (timeLeft > 0) {
                        $('#countdownText').text(`Wait ${timeLeft} seconds...`)
                        $('#finalDeleteBtn').text(`Delete Schedule (${timeLeft}s)`);
                    } else {
                        clearInterval(countdownInterval);
                        $('#finalDeleteBtn').prop('disabled', false).text("Delete Schedule Now");
                        $('#countdownText').text("Ready to delete.");
                    }
                }, 1000);
            });

            // Clean up interval if they close the modal early
            $('#deleteScheduleConfirmModal').on('hidden.bs.modal', function() {
                clearInterval(countdownInterval);
            });
        });
    </script>
</body>
</html>