<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= song.title %> - Song Details</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f4f7f9;
            color: #333;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .container {
            max-width: 900px;
        }
        .card {
            border-radius: 0.5rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .card:hover {
            transform: scale(1.02);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }
        .card-header {
            background-color: #007bff;
            color: #fff;
            font-weight: bold;
            border-bottom: 0;
            border-radius: 0.5rem 0.5rem 0 0;
        }
        .card-body {
            padding: 1.5rem;
        }
        .btn-custom {
            background-color: #007bff;
            color: #fff;
            border-radius: 0.375rem;
        }
        .btn-custom:hover {
            background-color: #0056b3;
        }
        .song-info {
            margin-bottom: 1rem;
            padding: 1rem;
            border-radius: 0.5rem;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .song-info h1 {
            font-size: 2rem;
        }
        .song-info h3 {
            font-size: 1.5rem;
            color: #4d4d4d;
        }
        .song-info h5 {
            font-size: 1.2rem;
            color: #6c757d;
        }
        .list-group-item {
            border: 0;
            padding: 1rem;
            background-color: #fff;
            transition: background-color 0.3s;
        }
        .list-group-item:hover {
            background-color: #f1f1f1;
        }
        pre {
            white-space: pre-wrap;
            background-color: #f8f9fa;
            padding: 0.5rem;
            border-radius: 0.375rem;
        }
    </style>
</head>
<body>
    <div class="container my-4">
        <div class="card song-info">
            <div class="card-body">
                <h1 class="mb-3">
                    <% if(song.book_song_number) { %>
                        <%= song.book_song_number %>. <%= song.title%>
                    <% } else { %>
                        <%= song.title %>
                    <% } %>
                </h1>
                <% if(song.artist) { %>
                    <h3 class="mb-3">Artist: <%= song.artist %></h3>
                <% } %>

                <% if (song.book_name ) { %>
                    <h5 class="mt-4">
                        <%= song.book_name %>
                    </h5>
                <% } %>
                <form action="/request-song" method="POST" class="mb-0">
                    <input type="hidden" name="song_uid" value="<%= song.song_uid%>">
                    <button type="submit" class="btn btn-warning btn-sm btn-request">Request</button>
                </form>
                <form action="/edit-song/<%= song.song_uid %>" method="GET" class="mb-0">
                    <button type="submit" class="btn btn-success btn-sm btn-request">Edit song</button>
                </form>                
            </div>
        </div>

        <h2 class="mt-4">Song Parts</h2>
        <div class="card">
            <div class="card-body">
                <ul class="list-group">
                    <% song.parts.forEach(part => { %>
                        <li class="list-group-item">
                            <strong><%= part.part_type %>:</strong>
                            <pre><%= part.lyrics %></pre>
                        </li>
                    <% }) %>
                </ul>
            </div>
        </div>

        <a href="/" class="btn btn-custom mt-4">Back to Home</a>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
