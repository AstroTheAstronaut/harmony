<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>Harmony</title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
</head>
<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <div class="row align-items-center">
                                <!-- Text content column -->
                                <div class="col-md-8">
                                    <h2 class="text-dark fw-bold m-0">
                                        <% if(song.book_song_number) { %>
                                            <%= song.book_song_number %>. <%= song.title%>
                                        <% } else { %>
                                            <%= song.title %>
                                        <% } %>
                                    </h2>
                                    <% if(song.artist) { %>
                                        <h5 class="mt-2">Artist: <%= song.artist %></h5>
                                    <% } %>
                                    <% if (song.book_name ) { %>
                                        <h5 class="mt-2">
                                            <%= song.book_name %>
                                        </h5>
                                    <% } %>
                                </div>
                                
                                <!-- Buttons column -->
                                <div class="col-md-4 d-flex justify-content-end d-none d-md-flex">
                                    <form action="/request-song" method="POST" class="mb-0 me-2">
                                        <input type="hidden" name="song_uid" value="<%= song.song_uid%>">
                                        <button type="submit" class="btn btn-warning btn-sm">Request</button>
                                    </form>
                                    <form action="/edit-song/<%= song.song_uid %>" method="GET" class="mb-0">
                                        <button type="submit" class="btn btn-success btn-sm">Edit song</button>
                                    </form>
                                </div>
                            </div>
                            <!-- Mobile buttons container -->
                            <div class="d-md-none mt-3">
                                <form action="/request-song" method="POST" class="mb-2">
                                    <input type="hidden" name="song_uid" value="<%= song.song_uid%>">
                                    <button type="submit" class="btn btn-warning btn-sm w-100">Request</button>
                                </form>
                                <form action="/edit-song/<%= song.song_uid %>" method="GET">
                                    <button type="submit" class="btn btn-success btn-sm w-100">Edit song</button>
                                </form>
                            </div>
                        </div>
                        <div class="card-body">
                            <ul class="list-group">
                                <% song.parts.forEach(part => { %>
                                    <li class="list-group-item">
                                        <strong><%= part.part_type %>:</strong>
                                        <pre><%= part.lyrics %></pre>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="bg-white sticky-footer">
                <div class="container my-auto">
                    <div class="text-center my-auto copyright"><span>Harmony App<br>All glory be to God!</span>
                    </div>
                </div>
            </footer>
            <a class="border rounded d-inline scroll-to-top" href="#page-top"><i class="fas fa-angle-up"></i></a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
