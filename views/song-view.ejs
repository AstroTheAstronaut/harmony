<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>
        <% if(song.book_song_number) { %>
            <% if(song.book_name) { %>
                <%= song.book_song_number %>. <%= song.title %> - <%= song.book_name %>
            <% } else { %>
                <%= song.book_song_number %>. <%= song.title %>
            <% } %>
        <% } else { %>
            <%= song.title %>
        <% } %>
    </title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
</head>
<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <div class="row align-items-center">
                                <!-- Text content column -->
                                <div class="col-md-8">
                                    <h2 id="song-title" class="text-dark fw-bold m-0" contenteditable="false">
                                        <% if(song.book_song_number) { %>
                                            <%= song.book_song_number %>. <%= song.title %>
                                        <% } else { %>
                                            <%= song.title %>
                                        <% } %>
                                    </h2>
                                    <% if(song.artist) { %>
                                        <h5 id="song-artist" class="mt-2" contenteditable="false"><%= t('song.artist') %>: <%= song.artist %></h5>
                                    <% } %>
                                    <% if (song.book_name ) { %>
                                        <h5 id="song-book-name" class="mt-2" contenteditable="false"><%= song.book_name %></h5>
                                    <% } %>
                                </div>
                                
                                <!-- Buttons column -->
                                <div class="col-md-4 d-flex justify-content-end d-none d-md-flex">
                                    <form id="song-form" action="/update-song" method="POST" class="mb-0 me-2">
                                        <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                        <input type="hidden" name="title" id="hidden-title" value="<%= song.title %>">
                                        <input type="hidden" name="artist" id="hidden-artist" value="<%= song.artist %>">
                                        <input type="hidden" name="book_name" id="hidden-book-name" value="<%= song.book_name %>">
                                        <% song.parts.forEach(part => { %>
                                            <input type="hidden" name="part_<%= part.id %>" id="hidden-part-<%= part.id %>" value="<%= part.lyrics %>">
                                        <% }) %>
                                        <% if(userRole === 'Viewer' || userRole === 'Moderator') {} else { %>
                                        <button id="edit-button" type="button" class="btn btn-success btn-sm" data-edit="false"><%= t('messages.edit_song') %></button>
                                        <button id="save-button" type="submit" class="btn btn-primary btn-sm d-none"><%= t('messages.save_song') %></button>
                                        <% } %>
                                    </form>

                                    <!-- Share button -->
                                    <a href="/song/<%= song.song_uid %>/public" id="share-button" class="btn btn-sm ms-2"
                                        data-song-title="<% if(song.book_song_number) { %><% if(song.book_name) { %><%= song.book_song_number %>. <%= song.title %> - <%= song.book_name %><% } else { %><%= song.book_song_number %>. <%= song.title %><% } %><% } else { %><%= song.title %><% } %>">
                                         <i class="fa-regular fa-share-from-square"></i>
                                     </a>                                                                                                                                    
                                    
                                    <!-- Desktop buttons container -->
                                    <% if(userRole === 'Viewer' || userRole === 'Moderator') {
                                        
                                    } else { %>
                                    <form action="/request-song" method="POST" class="mb-0 me-2">
                                        <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                        <button type="submit" class="btn btn-warning btn-sm"><%= t('general.request') %></button>
                                    </form>
                                    <form action="/remove-song" method="POST" class="d-inline ms-2">
                                        <input type="hidden" name="redirectTo" value="<%= decodeURIComponent (requestURL) %>">
                                        <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                        <button type="submit" class="btn btn-danger btn-sm"><%= t('general.remove') %></button>
                                    </form>
                                    <% } %>
                                </div>
                            </div>
                            <!-- Mobile buttons-->
                            <div class="d-md-none mt-3 d-flex justify-content-end">
                                <!-- Share button -->
                                <a href="/song/<%= song.song_uid %>/public" id="share-button-mobile" class="btn btn-sm ms-2"
                                    data-song-title="<% if(song.book_song_number) { %><% if(song.book_name) { %><%= song.book_song_number %>. <%= song.title %> - <%= song.book_name %><% } else { %><%= song.book_song_number %>. <%= song.title %><% } %><% } else { %><%= song.title %><% } %>">
                                     <i class="fa-regular fa-share-from-square"></i>
                                 </a>                                 
                                 
                            </div>
                            <% if(userRole === 'Viewer' || userRole === 'Moderator') {} else { %>
                            <!-- Mobile admin/mod buttons -->
                            <div class="d-md-none mt-3">
                                <form action="/request-song" method="POST" class="mb-2">
                                    <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                    <button type="submit" class="btn btn-warning btn-sm w-100"><%= t('general.request') %></button>
                                </form>
                                <form action="" method="GET">
                                    <button type="submit" class="btn btn-success btn-sm w-100"><%= t('messages.edit_song') %></button>
                                </form>
                            </div>
                            <% } %>
                        </div>
                        <div class="card-body">
                            <ul class="list-group">
                                <% song.parts.forEach(part => { %>
                                    <li class="list-group-item">
                                        <strong>
                                            <% if (part.part_type === "CHORUS" || part.part_type === "Chorus") { %>
                                                <%= t('song_parts.chorus') %>:
                                            <% } else if (part.part_type === "VERSE" || part.part_type === "Verse") { %>
                                                <%= t('song_parts.verse') %>:
                                            <% } else if (part.part_type === "BRIDGE" || part.part_type === "BRIDGE") { %>
                                                <%= t('song_parts.bridge') %>:
                                            <% } else if (part.part_type === "CODA" || part.part_type === "Coda") { %>
                                                <%= t('song_parts.coda') %>:
                                            <% } else if (part.part_type === "OUTRO" || part.part_type === "Outro") { %>
                                                <%= t('song_parts.outro') %>:
                                            <% } else if (part.part_type === 'INTRO' || part.part_type === "Intro") { %>
                                                <%= t('song_parts.intro') %>:
                                            <% } else { %>
                                                <%= t('song_parts.unknown') %>:
                                            <% } %>
                                        </strong>
                                        <pre id="part-<%= part.id %>" class="part-text" contenteditable="false"><%= part.lyrics %></pre>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>                        
                    </div>
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>

    <script>

        function handleShare(event, buttonId) {
            event.preventDefault();  // Prevent the default action (navigation)

            const shareUrl = window.location.origin + document.getElementById(buttonId).getAttribute('href');  // Get the link to share
            const songTitle = document.getElementById(buttonId).getAttribute('data-song-title');  // Get the song title from the data attribute
            const songText = `${songTitle}\n\n${shareUrl}`;

            // Check if the Web Share API is supported
            if (navigator.share) {
                navigator.share({
                    title: songTitle,
                    text: songText,
                    url: shareUrl
                }).then(() => {
                    console.log('Successfully shared');
                }).catch((error) => {
                    console.error('Error sharing', error);
                });
            } else {
                // Fallback to copying URL to clipboard if Web Share API isn't supported
                navigator.clipboard.writeText(shareUrl).then(() => {
                    alert('Link copied to clipboard!');
                }).catch((error) => {
                    console.error('Error copying text', error);
                });
            }
        }

        document.getElementById('share-button').addEventListener('click', function(event) {
            handleShare(event, 'share-button');
        });

        document.getElementById('share-button-mobile').addEventListener('click', function(event) {
            handleShare(event, 'share-button-mobile');
        });

        document.addEventListener('DOMContentLoaded', () => {
            const editButton = document.getElementById('edit-button');
            const saveButton = document.getElementById('save-button');
            const title = document.getElementById('song-title');
            const artist = document.getElementById('song-artist');
            const bookName = document.getElementById('song-book-name');
            const parts = document.querySelectorAll('.part-text');

            const hiddenTitle = document.getElementById('hidden-title');
            const hiddenArtist = document.getElementById('hidden-artist');
            const hiddenBookName = document.getElementById('hidden-book-name');
            const hiddenParts = [...document.querySelectorAll('input[name^="part_"]')];

            editButton.addEventListener('click', () => {
                const isEditing = editButton.getAttribute('data-edit') === 'true';
                
                if (isEditing) {
                    // Save mode
                    saveButton.classList.add('d-none');
                    editButton.classList.remove('d-none');
                    editButton.textContent = 'Edit';
                    editButton.setAttribute('data-edit', 'false');
                    
                    // Update hidden fields with current editable content
                    hiddenTitle.value = title.textContent.trim();
                    hiddenArtist.value = artist.textContent.trim();
                    hiddenBookName.value = bookName.textContent.trim();
                    hiddenParts.forEach((input, index) => {
                        input.value = parts[index].textContent.trim();
                    });

                    // Make fields read-only
                    title.contentEditable = 'false';
                    artist.contentEditable = 'false';
                    bookName.contentEditable = 'false';
                    parts.forEach(part => part.contentEditable = 'false');
                } else {
                    // Edit mode
                    saveButton.classList.remove('d-none');
                    editButton.classList.add('d-none');
                    editButton.textContent = 'Cancel';
                    editButton.setAttribute('data-edit', 'true');
                    
                    // Make fields editable
                    title.contentEditable = 'true';
                    artist.contentEditable = 'true';
                    bookName.contentEditable = 'true';
                    parts.forEach(part => part.contentEditable = 'true');
                }
            });
        });
    </script>
</body>
</html>
