<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Songs</title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/styles/sidebar.css">
    <link rel="stylesheet" href="/styles/songs-style.css">
    <!-- Font Awesome -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
</head>

<body>
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>

        <!-- Main content -->
        <div class="main-content">
            <div class="container mt-5">
                <!-- Sidebar Toggle Button (for mobile view) -->
                <button id="openSidebar" class="btn btn-primary d-md-none mb-3">
                    <i class="fa fa-bars"></i> Menu
                </button>

                <!-- Search Bar Section -->
                <div class="search-bar mb-4">
                    <form action="/search" method="GET" class="form-inline">
                        <input type="text" class="form-control mr-2" id="searchQuery" name="query"
                            placeholder="Search lyrics or artist" required>
                        <button type="submit" class="btn btn-primary">Search</button>
                    </form>
                </div>

                <!-- Songs List Section -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
            <% if (bookName==='All Books') { %>
                Songs List
            <% } else { %>
                Showing songs for: <%= bookName %>
            <% } %>
        </h4>
        <a href="/upload" class="btn btn-light">Upload a New Song</a>
        <!-- Dropdown for Filtering by Books -->
        <div class="dropdown ml-3">
            <button class="btn btn-light dropdown-toggle" type="button" id="bookFilterDropdown"
                data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Filter by Book
            </button>
            <div class="dropdown-menu" aria-labelledby="bookFilterDropdown">
                <a class="dropdown-item" href="/songs?book=all">All Books</a>
                <% books.forEach(book => { %>
                    <a class="dropdown-item" href="/songs?book=<%= book.bo_uid %>">
                        <%= book.bo_name %>
                    </a>
                <% }) %>
            </div>
        </div>
    </div>
    <div class="card-body">
        <% if (songs.length > 0) { %>
            <ul class="list-group" id="songs-list">
                <% songs.forEach(song => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center position-relative">
                        <div>
                            <a href="/song-view/<%= song.song_uid %>"
                                class="text-decoration-none text-dark">
                                <strong>
                                    <% if (song.book_song_number) { %>
                                        <%= song.book_song_number %>. <%= song.title %>
                                    <% } else { %>
                                        <%= song.title %>
                                    <% } %>
                                </strong>
                            </a>
                            <% if (song.artist) { %>
                                <span class="text-muted"> by <%= song.artist %></span>
                            <% } %>
                        </div>
                        <div class="d-none d-md-block">
                            <form action="/request-song" method="POST" class="d-inline">
                                <input type="hidden" name="song_name" value="<%= song.title %>">
                                <button type="submit" class="btn btn-warning btn-sm">Request</button>
                            </form>
                            <form action="/remove-song" method="POST" class="d-inline ml-2">
                                <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </div>
                        <!-- Mobile dropdown for actions -->
<div class="dropdown d-md-none">
    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="actionsDropdown<%= song.song_uid %>"
        data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Actions
    </button>
    <div class="dropdown-menu" aria-labelledby="actionsDropdown<%= song.song_uid %>">
        <form action="/request-song" method="POST" class="px-3 py-2">
            <input type="hidden" name="song_name" value="<%= song.title %>">
            <button type="submit" class="btn btn-warning btn-sm">Request</button>
        </form>
        <form action="/remove-song" method="POST" class="px-3 py-2">
            <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
        </form>
    </div>
</div>

                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p class="text-center">No songs available!</p>
        <% } %>
    </div>
</div>

                <!-- Pagination Section -->
                <div class="pagination mt-4">
                    <ul class="pagination justify-content-center">
                        <% if (currentPage> 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="/songs?page=<%= currentPage - 1 %>&limit=10"
                                    aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                            <% } else { %>
                                <li class="page-item disabled">
                                    <span class="page-link" aria-hidden="true">&laquo;</span>
                                </li>
                                <% } %>

                                    <% if (totalPages <=7) { %>
                                        <% for (let i=1; i <=totalPages; i++) { %>
                                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                <a class="page-link" href="/songs?page=<%= i %>&limit=10">
                                                    <%= i %>
                                                </a>
                                            </li>
                                            <% } %>
                                                <% } else { %>
                                                    <% if (currentPage <=4) { %>
                                                        <% for (let i=1; i <=5; i++) { %>
                                                            <li
                                                                class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                                <a class="page-link"
                                                                    href="/songs?page=<%= i %>&limit=10">
                                                                    <%= i %>
                                                                </a>
                                                            </li>
                                                            <% } %>
                                                                <li class="page-item disabled"><span
                                                                        class="page-link">...</span></li>
                                                                <li class="page-item">
                                                                    <a class="page-link"
                                                                        href="/songs?page=<%= totalPages %>&limit=10">
                                                                        <%= totalPages %>
                                                                    </a>
                                                                </li>
                                                                <% } else if (currentPage>= totalPages - 3) { %>
                                                                    <li class="page-item">
                                                                        <a class="page-link"
                                                                            href="/songs?page=1&limit=10">1</a>
                                                                    </li>
                                                                    <li class="page-item disabled"><span
                                                                            class="page-link">...</span></li>
                                                                    <% for (let i=totalPages - 4; i <=totalPages; i++) {
                                                                        %>
                                                                        <li
                                                                            class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                                            <a class="page-link"
                                                                                href="/songs?page=<%= i %>&limit=10">
                                                                                <%= i %>
                                                                            </a>
                                                                        </li>
                                                                        <% } %>
                                                                            <% } else { %>
                                                                                <li class="page-item">
                                                                                    <a class="page-link"
                                                                                        href="/songs?page=1&limit=10">1</a>
                                                                                </li>
                                                                                <li class="page-item disabled"><span
                                                                                        class="page-link">...</span>
                                                                                </li>
                                                                                <% for (let i=currentPage - 2; i
                                                                                    <=currentPage + 2; i++) { %>
                                                                                    <li
                                                                                        class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                                                        <a class="page-link"
                                                                                            href="/songs?page=<%= i %>&limit=10">
                                                                                            <%= i %>
                                                                                        </a>
                                                                                    </li>
                                                                                    <% } %>
                                                                                        <li class="page-item disabled">
                                                                                            <span
                                                                                                class="page-link">...</span>
                                                                                        </li>
                                                                                        <li class="page-item">
                                                                                            <a class="page-link"
                                                                                                href="/songs?page=<%= totalPages %>&limit=10">
                                                                                                <%= totalPages %>
                                                                                            </a>
                                                                                        </li>
                                                                                        <% } %>
                                                                                            <% } %>

                                                                                                <% if (currentPage <
                                                                                                    totalPages) { %>
                                                                                                    <li
                                                                                                        class="page-item">
                                                                                                        <a class="page-link"
                                                                                                            href="/songs?page=<%= currentPage + 1 %>&limit=10"
                                                                                                            aria-label="Next">
                                                                                                            <span
                                                                                                                aria-hidden="true">&raquo;</span>
                                                                                                        </a>
                                                                                                    </li>
                                                                                                    <% } else { %>
                                                                                                        <li
                                                                                                            class="page-item disabled">
                                                                                                            <span
                                                                                                                class="page-link"
                                                                                                                aria-hidden="true">&raquo;</span>
                                                                                                        </li>
                                                                                                        <% } %>
                    </ul>
                </div>
            </div>
        </div>

        <!-- jQuery, Popper.js, and Bootstrap JS from CDN -->
        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js"
            integrity="sha384-b/U6ypiBEHpOf/4+1nzFpr53nxSS+GLCkfwBdFNTxtclqqenISfwAzpKaMNFNmj4"
            crossorigin="anonymous"></script>

        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

        <!-- Custom JS -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const openSidebarButton = document.getElementById('openSidebar');
                const closeSidebarButton = document.getElementById('closeSidebar');
                const sidebar = document.getElementById('side_nav');

                if (openSidebarButton && closeSidebarButton && sidebar) {
                    openSidebarButton.addEventListener('click', function () {
                        sidebar.classList.add('active');
                    });

                    closeSidebarButton.addEventListener('click', function () {
                        sidebar.classList.remove('active');
                    });

                    document.addEventListener('click', function (event) {
                        if (!sidebar.contains(event.target) && !openSidebarButton.contains(event.target)) {
                            sidebar.classList.remove('active');
                        }
                    });
                }
            });
        </script>
</body>

</html>