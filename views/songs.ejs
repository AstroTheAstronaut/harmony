<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('general.songs') %> - <%= t('general.harmony') %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <!-- Custom CSS -->
    <style>
        @media (max-width: 576px) { /* Adjust the max-width as needed */
            .pagination {
                font-size: 0.875rem; /* Reduce font size */
            }
            .pagination .page-link {
                padding: 0.25rem 0.5rem; /* Adjust padding */
            }
            .pagination .page-item {
                margin: 0; /* Remove margin */
            }
        }
    
        /* Custom styles for form controls */
        .form-label {
            font-weight: 600;
        }
    </style>
    
</head>

<body id="page-top">
    <div id="wrapper">
    <%- include('partials/sidebar') %>
    <div class="d-flex flex-column" id="content-wrapper">
        <div id="content">
            <%- include('partials/navbar') %>
            <div class="container-fluid">
                <h3 class="text-dark mb-0"><%= t('general.songs') %></h3>
                </br>
                <div class="card shadow">
                    <div class="card-header py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <p class="text-primary m-0 fw-bold">
                                <% if (bookName === 'All Books') { %>
                                    <%= t('messages.showing_all_songs') %>
                                <% } else { %>
                                    <span class="d-block d-md-inline"><%= t('messages.showing_songs_for') %>:</span>
                                    <span class="d-block d-md-inline"><%= bookName %></span>
                                <% } %>
                                
                            </p>
                            <div class="d-flex flex-column flex-md-row justify-content-end align-items-start align-items-md-center" style="gap: 1rem;">
                                <!-- Order by Selection -->
                                <form id="orderByForm" class="d-flex align-items-center mb-0 me-3">
                                    <label for="orderBySelect" class="me-2" style="white-space: nowrap;">Order by:</label>
                                    <select class="form-select form-select-sm" id="orderBySelect">
                                        <option value="titleAsc" selected>Title: A-Z</option>
                                        <option value="titleDesc">Title: Z-A</option>
                                        <option value="noAsc">Number: Low to High</option>
                                        <option value="noDesc">Number: High to Low</option>
                                        <option value="artistAsc">Artist: A-Z</option>
                                        <option value="artistDesc">Artist: Z-A</option>
                                        <option value="bookAsc">Book: A-Z</option>
                                        <option value="bookDesc">Book: Z-A</option>
                                    </select>
                                </form>
                                <!-- Page Size Selection -->
                                <form id="pageSizeForm" class="d-flex align-items-center mb-0 me-3">
                                    <label for="itemsPerPage" class="me-2" style="white-space: nowrap;"><%= t('messages.show') %>:</label>
                                    <select class="form-select form-select-sm" id="pageSizeSelect">
                                        <option value="10" default <% if (limit === 10) { %> selected <% } %>>10</option>
                                        <option value="25" <% if (limit === 25) { %> selected <% } %>>25</option>
                                        <option value="50" <% if (limit === 50) { %> selected <% } %>>50</option>
                                        <option value="100" <% if (limit === 100) { %> selected <% } %>>100</option>
                                    </select>
                                </form>
                                <!-- Filter by Book -->
                                <form id="filterForm" class="d-flex align-items-center mb-0">
                                    <label class="form-label mb-0 me-2" for="bookFilterSelect"><%= t('messages.book') %>:</label>
                                    <select class="form-select form-select-sm" id="bookFilterSelect">
                                        <option value="all" <% if (bookName === 'All Books') { %> selected <% } %>> <%= t('messages.all_books') %></option>
                                        <% books.forEach(book => { %>
                                            <option value="<%= book.bo_uid %>" <% if (book.bo_name === bookName) { %> selected <% } %>>
                                                <%= book.bo_name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-body">
                        <% if (songs.length > 0) { %>
                            <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th><%= t('general.no') %></th>
                                        <th><%= t('song.title') %></th>
                                        <th><%= t('song.artist') %></th>
                                        <th><%= t('book.book') %></th>
                                        <% if(userRole === 'Viewer') {} else { %>
                                        <th><%= t('general.actions') %></th>
                                        <% } %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% songs.forEach((song, index) => { %>
                                        <tr>
                                            <td><%= song.book_song_number || (index + 1) %></td>
                                            <td>
                                                <a href="/song-view/<%= song.song_uid %>" class="text-decoration-none text-dark">
                                                    <%= song.title %>
                                                </a>
                                            </td>
                                            <td><%= song.artist || 'N/A' %></td>
                                            <td><%= song.bo_name || 'N/A' %></td>
                                            <td>
                                                <% if(userRole === 'Viewer') {} else { %>
                                                <!-- Desktop actions -->
                                                <div class="d-none d-md-block">
                                                    <% if(userRole === 'Editor') {} else{ %>
                                                    <form action="/request-song" method="POST" class="d-inline">
                                                        <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                                        <button type="submit" class="btn btn-warning btn-sm"><%= t('general.request') %></button>
                                                    </form>
                                                    <% } %>
                                                    <% if(userRole === 'Moderator') {} else { %>
                                                        <form action="/remove-song" method="POST" class="d-inline ms-2">
                                                            <input type="hidden" name="redirectTo" value="<%= decodeURIComponent (requestURL) %>">
                                                            <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                                            <button type="submit" class="btn btn-danger btn-sm"><%= t('general.remove') %></button>
                                                        </form>                                                        
                                                    <% } %>
                                                </div>
                                                <!-- Mobile dropdown for actions -->
                                                <div class="dropdown d-md-none">
                                                    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button"
                                                        id="actionsDropdown<%= song.song_uid %>" data-bs-toggle="dropdown"
                                                        aria-haspopup="true" aria-expanded="false">
                                                        <%= t('general.actions') %>
                                                    </button>
                                                    <div class="dropdown-menu" aria-labelledby="actionsDropdown<%= song.song_uid %>">
                                                        <form action="/request-song" method="POST" class="px-3 py-2">
                                                            <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                                            <button type="submit" class="btn btn-warning btn-sm"><%= t('general.request') %></button>
                                                        </form>
                                                        <form action="/remove-song" method="POST" class="px-3 py-2">
                                                            <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                                            <button type="submit" class="btn btn-danger btn-sm"><%= t('general.remove') %></button>
                                                        </form>
                                                    </div>
                                                </div>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th><%= t('general.no') %></th>
                                        <th><%= t('song.title') %></th>
                                        <th><%= t('song.artist') %></th>
                                        <th><%= t('book.book') %></th>
                                        <% if(userRole === 'Viewer') {} else { %>
                                        <th><%= t('general.actions') %></th>
                                        <% } %>
                                    </tr>
                                </tfoot>
                            </table>
                        <% } else { %>
                            <p class="text-center"><%= t('messages.no_songs_available') %>!</p>
                        <% } %>
                    </div>
                    <div class="card-footer py-3">
                        <div class="row">
                            <div class="col-md-6 align-self-center">
                                <p id="dataTable_info" class="dataTables_info" role="status" aria-live="polite">
                                    
                                </p>
                            </div>
                            <div class="col-md-6">
                                <div class="text-center">
                                    <nav class="d-lg-flex justify-content-lg-end dataTables_paginate paging_simple_numbers">
                                        <ul class="pagination">
                                            <!-- Previous Page Button -->
                                            <% if (currentPage > 1) { %>
                                                <li class="page-item">
                                                    <a class="page-link" href="/songs?page=<%= currentPage - 1 %>&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>" aria-label="Previous">
                                                        <span aria-hidden="true">&laquo;</span>
                                                    </a>
                                                </li>
                                            <% } else { %>
                                                <li class="page-item disabled">
                                                    <span class="page-link" aria-hidden="true">&laquo;</span>
                                                </li>
                                            <% } %>
                                            
                                            <!-- Page Numbers -->
                                            <% if (totalPages <= 7) { %>
                                                <% for (let i = 1; i <= totalPages; i++) { %>
                                                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                        <a class="page-link" href="/songs?page=<%= i %>&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>"><%= i %></a>
                                                    </li>
                                                <% } %>
                                            <% } else { %>
                                                <!-- Handle large number of pages with ellipsis -->
                                                <% if (currentPage <= 4) { %>
                                                    <% for (let i = 1; i <= 5; i++) { %>
                                                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                            <a class="page-link" href="/songs?page=<%= i %>&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>"><%= i %></a>
                                                        </li>
                                                    <% } %>
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                    <li class="page-item">
                                                        <a class="page-link" href="/songs?page=<%= totalPages %>&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>"><%= totalPages %></a>
                                                    </li>
                                                <% } else if (currentPage >= totalPages - 3) { %>
                                                    <li class="page-item">
                                                        <a class="page-link" href="/songs?page=1&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>">1</a>
                                                    </li>
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                    <% for (let i = totalPages - 4; i <= totalPages; i++) { %>
                                                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                            <a class="page-link" href="/songs?page=<%= i %>&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>"><%= i %></a>
                                                        </li>
                                                    <% } %>
                                                <% } else { %>
                                                    <li class="page-item">
                                                        <a class="page-link" href="/songs?page=1&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>">1</a>
                                                    </li>
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                    <% for (let i = currentPage - 2; i <= currentPage + 2; i++) { %>
                                                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                            <a class="page-link" href="/songs?page=<%= i %>&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>"><%= i %></a>
                                                        </li>
                                                    <% } %>
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                    <li class="page-item">
                                                        <a class="page-link" href="/songs?page=<%= totalPages %>&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>"><%= totalPages %></a>
                                                    </li>
                                                <% } %>
                                            <% } %>
                                        
                                            <!-- Next Page Button -->
                                            <% if (currentPage < totalPages) { %>
                                                <li class="page-item">
                                                    <a class="page-link" href="/songs?page=<%= currentPage + 1 %>&limit=10<%= bookId ? '&book=' + encodeURIComponent(bookId) : '' %>" aria-label="Next">
                                                        <span aria-hidden="true">&raquo;</span>
                                                    </a>
                                                </li>
                                            <% } else { %>
                                                <li class="page-item disabled">
                                                    <span class="page-link" aria-hidden="true">&raquo;</span>
                                                </li>
                                            <% } %>
                                        </ul>                                    
                                    </nav>
                                </div>
                            </div>                            
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('partials/footer') %>
            </div> 
        </div>
    </div>


    <!-- jQuery, Popper.js, and Bootstrap JS from CDN -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>

    <!-- Custom JS -->
    <script>
        document.getElementById('bookFilterSelect').addEventListener('change', function() {
            var form = document.getElementById('filterForm');
            var selectedValue = this.value;
            // Assuming you want to navigate to a URL with the selected book
            window.location.href = '/songs?book=' + selectedValue;
        });

        document.getElementById('pageSizeSelect').addEventListener('change', function() {
        var selectedSize = this.value;
        var currentPage = "<%= currentPage %>"; // Get the current page number from server-side code
        var bookFilter = document.getElementById('bookFilterSelect').value;
        var url = '/songs?page=' + currentPage + '&limit=' + selectedSize + (bookFilter !== 'all' ? '&book=' + encodeURIComponent(bookFilter) : '');
        window.location.href = url;
    });
    </script>
</body>
</html>