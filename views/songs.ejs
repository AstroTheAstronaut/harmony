<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Songs</title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!-- Custom CSS -->
     <link rel="stylesheet" href="/styles/sidebar.css">
     <link rel="stylesheet" href="/styles/songs-style.css">
     <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
</head>

<body>
    <%- include('partials/sidebar') %>

    <div class="main-content">
        <div class="container mt-5">
            <!-- Search Form -->
            <div class="card mb-4">
                <div class="card-header">
                    Search Lyrics
                </div>
                <div class="card-body">
                    <form action="/search" method="GET">
                        <div class="form-group">
                            <label for="searchQuery">Search Lyrics</label>
                            <input type="text" class="form-control" id="searchQuery" name="query" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Search</button>
                    </form>
                </div>
            </div>

            <div class="row">
                <!-- Books List -->
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header">Books</div>
                        <div class="card-body">
                            <% if (books.length > 0) { %>
                                <ul class="list-group">
                                    <% books.forEach(book => { %>
                                        <li class="align-items-center d-flex justify-content-between list-group-item">
                                            <div>
                                                <strong><%= book.bo_name %></strong> - <%= book.bo_uid %>
                                            </div>
                                            <button class="btn btn-danger btn-sm" data-book-id="<%= book.bo_uid %>"
                                                data-target="#deleteBookModal" data-toggle="modal" type="button">Delete</button>
                                        </li>
                                    <% }) %>
                                </ul>
                            <% } else { %>
                                <p class="text-center">No books uploaded!</p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Songs List -->
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header">
                            Songs List
                        </div>
                        <div class="card-body">
                            <% if (songs.length > 0) { %>
                                <ul class="list-group" id="songs-list">
                                    <% songs.forEach(song => { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center"
                                            data-book-id="<%= song.book_uuid %>">
                                            <div>
                                                <a href="/song-view/<%= song.song_uid %>" class="text-decoration-none text-dark">
                                                    <strong>
                                                        <% if (song.book_song_number) { %>
                                                            <%= song.book_song_number %>. <%= song.title %>
                                                        <% } else { %>
                                                            <%= song.title %>
                                                        <% } %>
                                                    </strong>
                                                </a>
                                                <% if (song.artist) { %>
                                                    <span class="text-muted"> by <%= song.artist %></span>
                                                <% } %>
                                                <span class="badge badge-secondary ml-2">
                                                    <%= song.bo_name || 'None' %>
                                                </span>
                                            </div>
                                            <form action="/request-song" method="POST" class="mb-0">
                                                <input type="hidden" name="song_name" value="<%= song.title %>">
                                                <button type="submit" class="btn btn-warning btn-sm">Request</button>
                                            </form>
                                            <form action="/remove-song" method="POST" class="mb-0">
                                                <input type="hidden" name="song_uid" value="<%= song.song_uid %>">
                                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                            </form>
                                        </li>
                                    <% }) %>
                                </ul>
                            <% } else { %>
                                <p class="text-center">No songs available!</p>
                            <% } %>
                        </div>
                    </div>
                </div>                
            </div>
            <!-- Upload Button -->
            <a href="/upload" class="btn btn-primary btn-lg my-4">Upload a new song</a>
        </div>
    </div>
    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>

</html>