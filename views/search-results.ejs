<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('general.harmony') %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <style>
        .title-highlight {
            background-color: rgba(255, 255, 0, 0.455);
            color: black;
            border-radius: 0.2em;
        }
    </style>
</head>

<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="d-sm-flex justify-content-between align-items-center mb-4">
                        <h3 class="text-dark mb-0"><%= t('messages.search_results') %> "<%= query %>" </h3>
                    </div>
                    <% if (results.length > 0) { %>
                    <div class="row-auto align-items-center">
                        <% results.forEach(result => { %>
                            <div class="card shadow mb-4" onclick="window.location.href='/song-view/<%= result.song_uid %>'">
                                <div class="card-header py-3">
                                    <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h3 class="text-dark fw-bold m-0 card-title">
                                            <% if(result.book_song_number) { %>
                                                <%= result.book_song_number %>. <%= result.title%>
                                            <% } else { %>
                                                <%= result.title %>
                                            <% } %>
                                        </h3>
                                        <% if(result.artist) { %>
                                            <h5 class="mt-2"><%= t('song.artist') %>: <%= result.artist %></h5>
                                        <% } %>
                                        <% if (result.bo_name) { %>
                                            <h5 class="mt-2"><%= result.bo_name %></h6>
                                        <% } %>
                                        <% if (result.chord) { %>
                                            <h5 class="mt-2"><%= t('song.chord') %>: <%= result.chord %></h5>
                                        <% } %>
                                    </div>
                                    <% if(userRole === 'Viewer' || userRole === 'Editor') {} else { %>
                                    <div class="col-md-4 d-flex justify-content-end d-none d-md-flex">
                                        <form action="/request-song" method="POST" class="mb-0 me-2">
                                            <input type="hidden" name="song_uid" value="<%= result.song_uid %>">
                                            <button type="submit" class="btn btn-warning btn-sm"><%= t('general.request') %></button>
                                        </form>
                                    </div>
                                    <div class="d-md-none mt-3">
                                        <form action="/request-song" method="POST" class="mb-2">
                                            <input type="hidden" name="song_uid" value="<%= result.song_uid %>">
                                            <button type="submit" class="btn btn-warning btn-sm w-100"><%= t('general.request') %></button>
                                        </form>
                                    </div>
                                    <% } %>
                                </div>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group">
                                        <li class="list-group-item">
                                            <% result.parts.forEach(part => { %>
                                                <p class="card-text">
                                                    <strong><%= part.part_type %></strong>
                                                    <% if (part.repetitions > 1) { %>
                                                        x<%= part.repetitions %>
                                                    <% } %>
                                                </p>
                                                <pre class="lyrics"><%= part.lyrics %></pre>
                                            <% }) %>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <% } else { %>
                        <div class="row-auto align-items-center">
                            <h6 class="text-dark fw-bold m-0"><%= t('messages.no_results');%></h6>
                        </div>
                    <% } %>
                </div>
                
            </div>
            <%- include('partials/footer') %>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script> 
    document.addEventListener("DOMContentLoaded", function() {
        const query = "<%= query %>";
        
        if (!query) return;

        // 1. Split query into individual words
        const words = query.trim().split(/\s+/).filter(w => w.length > 0);

        // 2. Define Romanian characters for boundaries
        const romanianChars = "a-zA-Z0-9ăĂâÂîÎșȘțȚşŞţŢ";
        const boundaryLookbehind = `(?<![${romanianChars}])`;
        const boundaryLookahead = `(?![${romanianChars}])`;

        // 3. Create a flexible pattern for EACH word (diacritic insensitive)
        const wordPatterns = words.map(word => {
            let safeWord = word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return safeWord
                .replace(/[aA]/g, '[aAăĂâÂ]')
                .replace(/[iI]/g, '[iIîÎ]')
                .replace(/[sS]/g, '[sSșȘşŞ]')
                .replace(/[tT]/g, '[tTțȚţŢ]');
        });

        // 4. Create the "Greedy Sequence" Regex
        // This looks complex, but here is the logic:
        // (Boundary + AnyOfOurWords + Boundary) followed by (Separators + Boundary + AnyOfOurWords + Boundary) repeated 0 or more times.
        
        const anySearchWord = `(${wordPatterns.join('|')})`;
        
        // Matches any whitespace or common punctuation (like commas) between words
        const separator = `[\\s,.-]+`; 

        const fullRegexStr = 
            `${boundaryLookbehind}${anySearchWord}${boundaryLookahead}` + 
            `(?:${separator}${boundaryLookbehind}${anySearchWord}${boundaryLookahead})*`;

        const combinedPattern = new RegExp(fullRegexStr, 'gi');

        // 5. Highlighting Helper
        function highlightText(selector, className) {
            document.querySelectorAll(selector).forEach(elem => {
                if (combinedPattern.test(elem.textContent)) {
                    combinedPattern.lastIndex = 0; // Reset regex cursor
                    elem.innerHTML = elem.innerHTML.replace(combinedPattern, match => {
                        return `<mark class="${className}">${match}</mark>`;
                    });
                }
            });
        }

        // Apply highlighting
        highlightText('.lyrics', ''); 
        highlightText('.card-title', 'title-highlight');
    });
</script>
    
</body>

</html>
