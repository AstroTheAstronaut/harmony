<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>Harmony</title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">

</head>

<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
            <div class="d-flex flex-column" id="content-wrapper">
                <div id="content">
                    <%- include('partials/navbar') %>
                        <div class="container-fluid">
                            <div class="d-sm-flex justify-content-between align-items-center mb-4">
                                <h3 class="text-dark mb-0">Dashboard</h3>
                            </div>
                            <div class="row">
                                <!-- Requested songs -->
                                <div class="col">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3">
                                            <h6 class="text-primary fw-bold m-0">Requested songs:</h6>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            <% if (requestedSongs.length> 0) { %>
                                                <% requestedSongs.forEach(song=> { %>
                                                    <li class="list-group-item">
                                                        <div class="row">
                                                            <div class="col-auto align-self-center me-2">
                                                                <a class="link-dark text-decoration-none"
                                                                    href="/song-view/<%= song.song_uid %>">
                                                                    <strong>
                                                                        <% if(song.book_song_number) { %>
                                                                            <%= song.book_song_number %>. <%= song.title
                                                                                    %>
                                                                                    <% } else { %>
                                                                                        <%= song.title %>
                                                                                            <% } %>
                                                                    </strong>
                                                                </a>
                                                                <% if (song.artist) { %> - <%= song.artist %>
                                                                        <% } %>
                                                                            <span class="text-xs ms-2">
                                                                                <%= song.request_time %>
                                                                            </span>
                                                                            <% if (song.book_song_number) { %>
                                                                                <span
                                                                                    class="badge rounded-pill bg-primary ms-2">
                                                                                    Book: <%= song.bo_name %>
                                                                                </span>
                                                                                <% } else { %>
                                                                                    <span
                                                                                        class="badge rounded-pill bg-primary ms-2">
                                                                                        Book: None
                                                                                    </span>
                                                                                    <% } %>
                                                            </div>
                                                            <div class="col-auto me-2 text-end ms-auto">
                                                                <form action="/remove-requested" method="post"
                                                                    style="display: inline;">
                                                                    <input type="hidden" name="request_id"
                                                                        value="<%= song.request_id %>">
                                                                    <button type="submit"
                                                                        class="btn btn-danger btn-sm">Remove
                                                                        Request</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </li>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <p class="text-center">No requests yet.</p>
                                                            <% } %>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3">
                                            <h6 class="text-primary fw-bold m-0">Most Requested Songs:</h6>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            <% if (mostRequestedSongs.length> 0) { %>
                                                <% mostRequestedSongs.forEach(song=> { %>
                                                    <li class="list-group-item">
                                                        <div class="row">
                                                            <div class="col-auto align-self-center me-2">
                                                                <a class="link-dark text-decoration-none"
                                                                    href="/song-view/<%= song.song_uid %>">
                                                                    <strong>
                                                                        <% if(song.book_song_number) { %>
                                                                            <%= song.book_song_number %>. <%= song.title
                                                                                    %>
                                                                                    <% } else { %>
                                                                                        <%= song.title %>
                                                                                            <% } %>
                                                                    </strong>
                                                                </a>
                                                                <% if (song.artist) { %> - <%= song.artist %>
                                                                        <% } %>
                                                                            <span class="text-xs ms-2">
                                                                                <%= song.request_time %>
                                                                            </span>
                                                                            <% if (song.book_song_number) { %>
                                                                                <span
                                                                                    class="badge rounded-pill bg-primary ms-2">
                                                                                    Book: <%= song.bo_name %>
                                                                                </span>
                                                                                <% } else { %>
                                                                                    <span
                                                                                        class="badge rounded-pill bg-primary ms-2">Book:
                                                                                        None</span>
                                                                                    <% } %>
                                                            </div>
                                                            <div class="col-auto me-2 text-end ms-auto">
                                                                <span class="badge bg-primary">Requests: <%=
                                                                        song.request_count %></span>
                                                            </div>
                                                        </div>
                                                    </li>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <p class="text-center">No requests yet.</p>
                                                            <% } %>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 mb-4">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3">
                                            <h6 class="text-primary fw-bold m-0">Books</h6>
                                        </div>
                                        <div class="card-body">
                                            <ul class="list-group">
                                                <% books.forEach(book=> { %>
                                                    <li class="list-group-item">
                                                        <div class="row">
                                                            <div class="col">
                                                                <h4 class="small fw-bold"
                                                                    style="color: var(--bs-emphasis-color); font-size: 16px;">
                                                                    <%= book.bo_name %>
                                                                </h4>
                                                                <!-- Placeholder for number of songs -->
                                                                <span
                                                                    class="float-start"><!-- Number of songs will be inserted here later --></span>
                                                            </div>
                                                            <div class="col-auto align-self-center">
                                                                <button class="btn btn-danger btn-sm"
                                                                    data-book-id="<%= book.bo_uid %>"
                                                                    data-target="#deleteBookModal" data-toggle="modal"
                                                                    type="button">Delete <%= book.bo_uid %></button>
                                                            </div>
                                                        </div>
                                                    </li>
                                                    <% }) %>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3">
                                            <h6 class="text-primary fw-bold m-0">Informatii de la Matteo</h6>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item">
                                                <div class="row g-0 align-items-center">
                                                    <div class="col me-2">
                                                        <h6 class="mb-0"><strong>Momentan cautatul nu merge pe mobile.</strong></h6><span
                                                            class="text-xs">10:30 AM</span>
                                                    </div>
                                                    <div class="col-auto">
                                                        
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="list-group-item">
                                                <div class="row g-0 align-items-center">
                                                    <div class="col me-2">
                                                        <h6 class="mb-0"><strong>Pagina de upload, pe ecrane cu touchscreen, e stricata. Merge doar daca nu mutati partile cantarii deloc.</strong></h6><span
                                                            class="text-xs">10:01 PM</span>
                                                    </div>
                                                    <div class="col-auto">
                                                        
                                                    </div>
                                                </div>
                                            </li>
                                            <li class="list-group-item">
                                                <div class="row g-0 align-items-center">
                                                    <div class="col me-2">
                                                        <h6 class="mb-0"><strong>Mai am de lucrat la aspectul unor pagini</strong></h6><span
                                                            class="text-xs">10:02 PM</span>
                                                    </div>
                                                    <div class="col-auto">
                                                    
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                        </div>
                </div>
                <footer class="bg-white sticky-footer">
                    <div class="container my-auto">
                        <div class="text-center my-auto copyright"><span>Harmony App<br>All glory be to God!</span>
                        </div>
                    </div>
                </footer>
            <a class="border rounded d-inline scroll-to-top" href="#page-top"><i class="fas fa-angle-up"></i></a>
    </div>
    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Function to show the modal with the correct book UUID
            document.querySelectorAll('[data-target="#deleteBookModal"]').forEach(button => {
                button.addEventListener('click', function () {
                    const bookId = this.getAttribute('data-book-id');
                    document.getElementById('bookUUIDDisplay').textContent = bookId;
                    document.getElementById('hiddenDeleteOnlyUUID').value = bookId;
                    document.getElementById('hiddenDeleteWithSongsUUID').value = bookId;
                });
            });

            // Function to enable/disable buttons based on UUID verification
            document.getElementById('confirmBookUUID').addEventListener('input', function () {
                const enteredUUID = this.value.trim();
                const displayedUUID = document.getElementById('bookUUIDDisplay').textContent;
                const deleteOnlyButton = document.querySelector('#deleteOnlyForm button');
                const deleteWithSongsButton = document.querySelector('#deleteWithSongsForm button');

                if (enteredUUID === displayedUUID) {
                    deleteOnlyButton.disabled = false;
                    deleteWithSongsButton.disabled = false;
                } else {
                    deleteOnlyButton.disabled = true;
                    deleteWithSongsButton.disabled = true;
                }
            });

            // Function to reset the modal when closed
            const modal = document.getElementById('deleteBookModal');
            modal.addEventListener('hidden.bs.modal', function () {
                document.getElementById('confirmBookUUID').value = '';
                document.querySelector('#deleteOnlyForm button').disabled = true;
                document.querySelector('#deleteWithSongsForm button').disabled = true;
            });
        });
    </script>

    <!-- Modal for deleting books -->
    <div class="modal fade" id="deleteBookModal" tabindex="-1" aria-labelledby="deleteBookModalLabel"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteBookModalLabel">Confirm Deletion</h5>
                    <button type="button" class="btn-close close" data-dismiss="modal" aria-label="Close"></button>

                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this book?</p>
                    <p>This action has two options:</p>
                    <ul>
                        <li><strong>Delete Only Book:</strong> This will remove the book entry but keep associated
                            songs.</li>
                        <li><strong>Delete Book with Songs:</strong> This will remove the book entry along with all
                            associated songs.</li>
                    </ul>
                    <p><strong>Book UUID:</strong> <span id="bookUUIDDisplay"></span></p>
                    <div class="form-group">
                        <label for="confirmBookUUID">Type the Book UUID to confirm:</label>
                        <input type="text" class="form-control" id="confirmBookUUID" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <form action="/delete-book" method="POST" class="d-inline" id="deleteOnlyForm">
                        <input name="book_uuid" type="hidden" id="hiddenDeleteOnlyUUID">
                        <button type="submit" class="btn btn-secondary" disabled>Delete Only Book</button>
                    </form>
                    <form action="/delete-book-with-songs" method="POST" class="d-inline" id="deleteWithSongsForm">
                        <input name="book_uuid" type="hidden" id="hiddenDeleteWithSongsUUID">
                        <button type="submit" class="btn btn-danger" disabled>Delete Book with Songs</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</body>
</html>