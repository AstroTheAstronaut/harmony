<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Harmony</title>
    <!-- Bootstrap CSS from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/styles/index-style.css">
    <link rel="stylesheet" href="/styles/sidebar.css">
</head>
<body>
    <%- include('partials/sidebar') %>
    <div class="main-content">
        <h1 class="text-center mb-4">Harmony Song Viewer</h1>

        <div class="container mt-5">
            <!-- Search Form -->
            <div class="card mb-4">
                <div class="card-header">
                    Search Lyrics
                </div>
                <div class="card-body">
                    <form action="/search" method="GET">
                        <div class="form-group">
                            <label for="searchQuery">Search Lyrics</label>
                            <input type="text" class="form-control" id="searchQuery" name="query" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Search</button>
                    </form>
                </div>
            </div>
            <div class="row">
                <!--  Requested Songs -->
                <div class="col-md-12 mb-4">
                    <div class="card">
                        <div class="card-header">
                            Requested Songs
                        </div>
                        <div class="card-body">
                            <ul class="list-group">
                                <% if (requestedSongs.length> 0) { %>
                                    <% requestedSongs.forEach(song=> { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <a href="/song-view/<%= song.song_uid %>" class="text-decoration-none text-dark">
                                                <strong>
                                                    <% if(song.book_song_number) { %>
                                                        <%= song.book_song_number %>. <%= song.title %>
                                                                <% } else {%>
                                                                    <%= song.title %>
                                                                        <% } %> 
                                                </strong>
                                            </a>
                                                <% if (song.artist) { %> - <%= song.artist %>
                                                        <% } %>
                                                            <% if (song.book_song_number) { %>
                                                                <span class="badge bg-secondary ml-2">
                                                                    Book: <%= song.bo_name %>
                                                                </span>
                                                                <% } else{ %>
                                                                    <span class="badge bg-secondary ml-2">
                                                                        Book: None
                                                                    </span>
                                                                    <% } %>
                                                                    <!-- <span class="badge bg-secondary ml-2">
                                                                        Req_id: <%= song.request_id %>
                                                                    </span> -->
                                            </div>
                                            <div>
                                                <span class="badge bg-primary">
                                                    Requests: <%= song.request_count %>
                                                </span>
                                                <!-- Remove Button -->
                                                <form action="/remove-requested" method="post" style="display: inline;">
                                                    <input type="hidden" name="request_id" value="<%= song.request_id %>">
                                                    <button type="submit" class="btn btn-danger btn-sm">Remove
                                                        request</button>
                                                </form>
                                            </div>
                                        </li>
                                        <% }) %>
                                            <% } else { %>
                                                <p class="text-center">No requests yet.</p>
                                                <% } %>
                            </ul>
                        </div>
                    </div>
                </div>
                <!-- Most Requested Songs -->
                <div class="col-md-12 mb-4">
                    <div class="card">
                        <div class="card-header">
                            Most Requested Songs
                        </div>
                        <div class="card-body">
                            <ul class="list-group">
                                <% if (mostRequestedSongs.length> 0) { %>
                                    <% mostRequestedSongs.forEach(song=> { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <a href="/song-view/<%= song.song_uid %>" class="text-decoration-none text-dark">
                                                <strong>
                                                    <% if(song.book_song_number) { %>
                                                        <%=song.book_song_number %>. <%= song.title %>
                                                                <% } else { %>
                                                                    <%= song.title %>
                                                                        <% } %>
                                                </strong>
                                                </a>
                                                <% if (song.artist) { %> - <%= song.artist %>
                                                    <% } %>
                                                        <% if (song.book_song_number) { %>
                                                            <span class="badge bg-secondary ml-2">
                                                                Book: <%= song.bo_name %>
                                                            </span>
                                                            <% } else{ %>
                                                                <span class="badge bg-secondary ml-2">
                                                                    Book: None
                                                                </span>
                                                                <% } %>
                                            </div>
                                            <div>
                                                <span class="badge bg-primary">
                                                    Requests: <%= song.request_count %>
                                                </span>
                                            </div>
                                        </li>
                                        <% }) %>
                                            <% } else { %>
                                                <p class="text-center">No requests yet.</p>
                                                <% } %>
                            </ul>
                        </div>
                    </div>
                </div>
                <!-- Books List -->
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header">Books</div>
                        <div class="card-body">
                            <ul class="list-group">
                                <% books.forEach(book=> { %>
                                    <li class="align-items-center d-flex justify-content-between list-group-item">
                                        <div><strong>
                                                <%= book.bo_name %>
                                            </strong> - <%= book.bo_uid %>
                                        </div>
                                        <button class="btn btn-danger btn-sm" data-book-id="<%= book.bo_uid %>"
                                            data-target="#deleteBookModal" data-toggle="modal"
                                            type="button">Delete</button>
                                    </li>
                                    <% }) %>
                            </ul>
                        </div>
                    </div>
                </div>
