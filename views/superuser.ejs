<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('superuser.superuser_dashboard') %> - <%= t('general.harmony'); %></title>
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900&display=swap">
    <style>
        .modal {
            color:rgba(0, 0, 0, 0.61);
        }
        @media (max-width: 576px) {
            .disable-last-connected {
                display: none !important
            }
        }
    </style>
</head>

<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="d-sm-flex justify-content-between align-items-center mb-4">
                        <h3 class="text-dark mb-0"><%= t('superuser.superuser_dashboard') %></h3>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 mb-4">
                            <%- include('partials/superuser/users') %>
                        </div>
                        <div class="col-lg-6 mb-4">
                            <%- include('partials/superuser/registration_codes_card') %>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 mb-4">
                            <%- include('partials/superuser/metrics') %>
                        </div>
                        <div class="col-lg-6 mb-4">
                            <%- include('partials/superuser/audit_log') %>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>
    </div>
    <%- include ('partials/superuser/create_reg_codes') %>
    <%- include ('partials/superuser/view_reg_codes_list') %>
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js"></script>
    <script src="/scripts/superuser.js"></script>
</body>
</html>