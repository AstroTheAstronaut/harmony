<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('general.notifications') %> - <%= t('general.harmony'); %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <!-- Custom CSS -->
    <style>
        .text-smaller-responsive {
            font-size: 0.8rem;
        }
    </style>
</head>

<%
// Helper function to build URLs with pagination parameters
function buildUrl(page) {
    const params = new URLSearchParams();
    params.set('page', page);
    if (currentFilter && currentFilter !== 'all') {
        params.set('filter', currentFilter);
    }
    if (pagination && pagination.limit !== 10) {
        params.set('limit', pagination.limit);
    }
    return '/notifications?' + params.toString();
}
%>

<body id="page-top">
    <div id="wrapper">
        <%- include('partials/sidebar') %>
        <div class="d-flex flex-column" id="content-wrapper">
            <div id="content">
                <%- include('partials/navbar') %>
                <div class="container-fluid">
                    <div class="d-sm-flex justify-content-between align-items-center mb-4">
                        <h3 class="text-dark mb-0"><%= t('general.notifications') %></h3>
                    </div>

                    <div class="row-auto">
                        <div class="card shadow">
                            <div class="card-header py-3">
                                <div class="row align-items-center">
                                    <div class="col-md-4">
                                        <h6 class="m-0 font-weight-bold text-primary">
                                            Active notifications 
                                            <% if (pagination) { %>
                                                <small class="text-muted">(Showing <%= notifications.length %> of <%= pagination.totalCount %>)</small>
                                            <% } %>
                                        </h6>
                                        <% if (pagination && pagination.totalCount > 0) { %>
                                            <small class="text-muted">
                                                Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
                                            </small>
                                        <% } %>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-0">
                                            <label for="filterSelect" class="form-label text-sm text-muted mb-1">Filter:</label>
                                            <select id="filterSelect" class="form-control form-control-sm" onchange="changeFilter(this.value)">
                                                <option value="all" <%= currentFilter === 'all' ? 'selected' : '' %>>All Notifications</option>
                                                <option value="unseen" <%= currentFilter === 'unseen' ? 'selected' : '' %>>Unread Only</option>
                                                <option value="seen" <%= currentFilter === 'seen' ? 'selected' : '' %>>Read Only</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-0">
                                            <label for="limitSelect" class="form-label text-sm text-muted mb-1">Per page:</label>
                                            <select id="limitSelect" class="form-control form-control-sm" onchange="changeLimit(this.value)">
                                                <option value="5" <%= pagination.limit === 5 ? 'selected' : '' %>>5</option>
                                                <option value="10" <%= pagination.limit === 10 ? 'selected' : '' %>>10</option>
                                                <option value="25" <%= pagination.limit === 25 ? 'selected' : '' %>>25</option>
                                                <option value="50" <%= pagination.limit === 50 ? 'selected' : '' %>>50</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <% if (notifications && notifications.length > 0) { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover" width="100%" cellspacing="0">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th>Status</th>
                                                    <th>Title</th>
                                                    <th>User</th>
                                                    <th>Description</th>
                                                    <th>Created at</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% notifications.forEach(notification => { %>
                                                    <tr class="<%= !notification.seen ? 'table-warning' : '' %>">
                                                        <td>
                                                            <% if (!notification.seen) { %>
                                                                <span class="text-danger">New</span>
                                                            <% } else { %>
                                                                <span class="text-dark">Read</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <% if (notification.type === 'song_request') { %>
                                                                <span class="text-dark"><i class="fas fa-music fa-sm"></i> Song Request</span>
                                                            <% } else if (notification.type === 'song_edited') { %>
                                                                <span class="text-dark"><i class="fas fa-edit fa-sm"></i> Song Edited</span>
                                                            <% } else { %>
                                                                <span class="text-dark"><i class="fas fa-bell fa-sm"></i> <%= notification.type %></span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <% if (notification.username) { %>
                                                                <span class="text-primary"><%= notification.username %></span>
                                                            <% } else { %>
                                                                <span class="text-muted">Unknown User</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <% if (notification.link) { %>
                                                                <a href="<%= notification.link %>" class="text-decoration-none">
                                                                    <%= notification.message %>
                                                                </a>
                                                            <% } else { %>
                                                                <%= notification.message %>
                                                            <% } %>
                                                        </td>
                                                        <td><%= new Date(notification.createdAt).toLocaleString() %></td>
                                                        <td>
                                                            <% if (!notification.seen) { %>
                                                                <a href="/notifications/mark-seen/<%= notification.notificationId %>" class="btn btn-success btn-sm me-1">Mark as Read</a>
                                                            <% } %>
                                                            <a href="/notifications/delete/<%= notification.notificationId %>" class="btn btn-danger btn-sm">Delete</a>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                    
                                    <!-- Pagination Controls -->
                                    <% if (pagination && pagination.totalPages > 1) { %>
                                        <nav aria-label="Notifications pagination" class="mt-4">
                                            <ul class="pagination justify-content-center">
                                                <!-- Previous Page -->
                                                <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
                                                    <a class="page-link" href="<%= pagination.hasPrevPage ? buildUrl(pagination.prevPage) : '#' %>">
                                                        <i class="fas fa-chevron-left"></i> Previous
                                                    </a>
                                                </li>
                                                
                                                <!-- Page Numbers -->
                                                <% 
                                                    const startPage = Math.max(1, pagination.currentPage - 2);
                                                    const endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
                                                %>
                                                
                                                <% if (startPage > 1) { %>
                                                    <li class="page-item">
                                                        <a class="page-link" href="<%= buildUrl(1) %>">1</a>
                                                    </li>
                                                    <% if (startPage > 2) { %>
                                                        <li class="page-item disabled">
                                                            <span class="page-link">...</span>
                                                        </li>
                                                    <% } %>
                                                <% } %>
                                                
                                                <% for (let i = startPage; i <= endPage; i++) { %>
                                                    <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                                                        <a class="page-link" href="<%= buildUrl(i) %>"><%= i %></a>
                                                    </li>
                                                <% } %>
                                                
                                                <% if (endPage < pagination.totalPages) { %>
                                                    <% if (endPage < pagination.totalPages - 1) { %>
                                                        <li class="page-item disabled">
                                                            <span class="page-link">...</span>
                                                        </li>
                                                    <% } %>
                                                    <li class="page-item">
                                                        <a class="page-link" href="<%= buildUrl(pagination.totalPages) %>"><%= pagination.totalPages %></a>
                                                    </li>
                                                <% } %>
                                                
                                                <!-- Next Page -->
                                                <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
                                                    <a class="page-link" href="<%= pagination.hasNextPage ? buildUrl(pagination.nextPage) : '#' %>">
                                                        Next <i class="fas fa-chevron-right"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        </nav>
                                    <% } %>
                                <% } else { %>
                                <div class="alert alert-info" role="alert">
                                    <strong>No notifications found.</strong> You will see notifications here when
                                    something important happens.
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="row-auto">
                    </div>
                    
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>
        </div>
        
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/script.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js"></script>
    <script>
        function changeFilter(filter) {
            const url = new URL(window.location);
            if (filter === 'all') {
                url.searchParams.delete('filter');
            } else {
                url.searchParams.set('filter', filter);
            }
            url.searchParams.set('page', '1'); // Reset to first page
            window.location.href = url.toString();
        }
        
        function changeLimit(limit) {
            const url = new URL(window.location);
            url.searchParams.set('limit', limit);
            url.searchParams.set('page', '1'); // Reset to first page
            window.location.href = url.toString();
        }
    </script>
</body>
</html>