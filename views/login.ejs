<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title><%= t('general.harmony') %></title>
    <!-- Bootstrap CSS from CDN -->
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <!-- Font Awesome CSS from CDN -->
    <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap">
    <style>
        body {
            background-image: url('/img/login-bg50.jpg');
            background-size: cover;
            color: #333;
        }

        .card {
            border-radius: 0.5rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .card-body {
            padding: 30px;
        }

        .btn-custom {
            background-color: #007bff;
            color: #fff;
            border-radius: 0.375rem;
            margin-bottom: 15px;
            width: 100%;
            padding: 10px;
            font-size: 1rem;
        }

        .btn-custom:hover {
            background-color: #0056b3;
        }

        .form-group {
            margin-top: 20px;
        }

        #loginBtn {
            width: 100%;
            border-radius: 0.375rem;
            margin-top: 10px;
        }

        h2 {
            margin-bottom: 30px;
            color: #333;
            text-align: center;
        }

        /* Center the card */
        .centered-card {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .card {
            width: 100%;
            max-width: 400px;
        }
    </style>
</head>

<body>
    <div class="container-fluid centered-card">
        <div class="card shadow">
            <div class="card-header py-3 text-center">
                <h3 class="text-primary fw-bold m-0">Login</h3>
            </div>
            <div class="card-body">
                <form id="loginForm" action="/auth/login-user" method="POST">
                    <div class="form-group">
                        <label for="roleInput">Role:</label>
                        <input type="text" name="role" id="roleInput" class="form-control" placeholder="Enter role (e.g., viewer, admin)" oninput="updatePasswordField()" required>
                    </div>
                    <div class="form-group" id="passwordGroup">
                        <input type="password" name="password" id="passwordInput" class="form-control" placeholder="Password" required>
                    </div>
                    <button type="submit" id="loginBtn" class="btn btn-custom">Login</button>
                </form>
            </div>
            <div class="card-footer text-center">
                <span class="d-block mb-2 h5">
                    <em><%= t('general.footer_verse') %></em>
                </span> 
            </div>
        </div>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
        function updatePasswordField() {
            const roleInput = document.getElementById('roleInput').value.trim().toLowerCase();
            const passwordGroup = document.getElementById('passwordGroup');
            const rolesRequiringPassword = ['moderator', 'editor', 'admin'];

            if (rolesRequiringPassword.includes(roleInput)) {
                passwordGroup.style.display = 'block';
            } else {
                passwordGroup.style.display = 'none';
                document.getElementById('passwordInput').value = ''; // Clear password input
            }
        }
    </script>
</body>
</html>
