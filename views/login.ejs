<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
  <title><%= t('general.login') %> - <%= t('general.harmony') %></title>
  <link rel="stylesheet" href="/styles/bootstrap.min.css" />
  <script src="https://kit.fontawesome.com/d3b482db3e.js" crossorigin="anonymous"></script>
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i&amp;display=swap" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/3.4.3/css/flag-icon.min.css" />

  <style>
    body {
      background-image: url('/img/login-bg50-min.jpg');
      background-size: cover;
      color: #333;
    }

    .card {
      border-radius: 0.5rem;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-width: 400px;
    }

    .card-body {
      padding: 30px;
    }

    .btn-custom {
      background-color: #007bff;
      color: #fff;
      border-radius: 0.375rem;
      margin-bottom: 15px;
      width: 100% !important;
      padding: 10px;
      font-size: 1rem;
    }

    .btn-custom:hover {
      background-color: #0056b3;
    }

    .form-group {
      margin-top: 20px;
    }

    #loginBtn {
      width: 100%;
      border-radius: 0.375rem;
      margin-top: 10px;
    }

    h2 {
      margin-bottom: 30px;
      color: #333;
      text-align: center;
    }

    /* Center the card */
    .centered-card {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .hidden {
      display: none;
    }

    @media (max-width: 576px) {
      body {
        background-image: none !important;
      }
    }
    @media (max-width: 768px) {
      body{
        background-image: none !important;
      }
    }
  </style>
</head>

<body>
  <div class="container-fluid centered-card">
    <div class="card shadow">
      <div class="card-header py-3 text-center">
        <h3 class="text-primary fw-bold m-0"><%= t('general.login') %></h3>
      </div>
      <div class="card-body">
        <% if (query.success) { %>
          <div class="success-message text-success"><%= t('login_page.user_registered_success') %></div>
        <% } %> 
        <% if (query && query.logout) { %>
          <div class="success-message text-success"><%= t('login_page.logout_success') %></div>
        <% } %>
        <form id="loginForm" action="/auth/login-user" method="POST">
          <input type="hidden" id="roleInput" name="role" value="" />
          <div class="form-group mb-2">
            <span class="label d-block mb-1"><%= t('login_page.login_user') %>:</span>
            <input id="usernameInput" type="text" name="username" class="form-control mb-2"
              placeholder="<%= t('login_page.username') %>" required />
            <input id="passwordInput" type="password" name="password" class="form-control"
              placeholder="<%= t('login_page.password') %>" required />
              <% if (typeof error !== 'undefined') { %>
                <span class="text-danger"><%= error %></span>
              <% } %>
          </div>

          <div class="mb-2">
            <span class="label">
              <%= t('login_page.register_message') %>
              <a href="/register"><%= t('general.click_here') %></a>
            </span>
          </div>
          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe">
            <label class="form-check-label" for="rememberMe">
              <%= t('login_page.remember_me') %>
            </label>
          </div>

          <button type="submit" id="loginBtn" class="btn btn-custom w-100 mb-2">
            <%= t('general.login') %>
          </button>

          <span class="label d-block mb-1"><%= t('login_page.login_as') %>:</span>
          <button type="button" class="btn btn-google btn-user w-100 mb-2" style="background: var(--bs-primary-text-emphasis);"
            id="viewerBtn">
            <%= t('login_page.viewer') %>
          </button>
        </form>
      </div>

      <div class="card-footer text-center">
        <span class="d-block mb-2 h5">
          <em><%= t('general.footer_verse') %></em>
        </span>
      </div>
    </div>

    <!-- Language Dropdown -->
    <div class="dropdown language-switcher position-absolute top-0 end-0 p-3">
      <a class="dropdown-toggle nav-link" aria-expanded="false" data-bs-toggle="dropdown" href="#">
        <% if (i18n.language === 'en') { %>
        <span class="flag-icon flag-icon-gb"></span>
        <% } else if (i18n.language === 'it') { %>
        <span class="flag-icon flag-icon-it"></span>
        <% } else if (i18n.language === 'ro') { %>
        <span class="flag-icon flag-icon-ro"></span>
        <% } else if (i18n.language === 'es') { %>
        <span class="flag-icon flag-icon-es"></span>
        <% } %>
      </a>
      <div class="dropdown-menu dropdown-menu-end animated--grow-in">
        <h6 class="dropdown-header"><%= t('messages.change_language') %></h6>
        <a class="dropdown-item" href="/change-language/en">
          <span class="flag-icon flag-icon-gb"></span> <%= t('messages.english') %>
        </a>
        <a class="dropdown-item" href="/change-language/it">
          <span class="flag-icon flag-icon-it"></span> <%= t('messages.italian') %>
        </a>
        <a class="dropdown-item" href="/change-language/ro">
          <span class="flag-icon flag-icon-ro"></span> <%= t('messages.romanian') %>
        </a>
        <a class="dropdown-item" href="/change-language/es">
          <span class="flag-icon flag-icon-es"></span> <%= t('messages.spanish') %>
        </a>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS and dependencies -->
  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
    integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
    integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
    integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/scripts/script.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
        const roleButtons = {
          'viewerBtn': 'Viewer',
        };

        Object.keys(roleButtons).forEach(buttonId => {
          const btn = document.getElementById(buttonId);
          if (!btn) return;

          btn.addEventListener('click', function () {
            const role = roleButtons[buttonId];
            document.getElementById('roleInput').value = role;

            // Set username to "viewer" and clear password for viewer role
            if (role === 'Viewer') {
              document.getElementById('usernameInput').value = 'viewer';
              document.getElementById('passwordInput').value = '';
              document.getElementById('loginForm').submit();
            } else {
              // Handle other roles if any
              const passwordGroup = document.getElementById('passwordGroup');
              const passwordLabel = document.getElementById('passwordLabel');
              passwordLabel.textContent = `<%= t('messages.entering_password_for') %> ${role}`;
              passwordGroup.classList.remove('hidden');
            }
          });
        });
      });
  </script>

</body>

</html>
