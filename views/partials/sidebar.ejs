            <div class="sidebar-brand-icon rotate-n-15" ><img src="/img/wave_black.svg" style="filter: invert(100%);width: 50px;"></div>
            <div class="sidebar-brand-text mx-3"><span><%= t('general.harmony') %></span></div>
        </a>
        <hr class="sidebar-divider my-0">
        <ul class="navbar-nav text-light" id="accordionSidebar">
            <li class="nav-item"><a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/"><i class="fas fa-tachometer-alt" style="font-size: 15px;"></i><span style="font-size: 15px;"><%= t('general.home') %></span></a></li>
            <li class="nav-item"><a class="nav-link <%= activePage === 'songs' ? 'active' : '' %>" href="/songs"><i class="fas fa-music" style="width: 15.6016px;font-size: 15px;"></i><span style="font-size: 15px;"><%= t('general.songs') %></span></a></li>
            <li class="nav-item"><a class="nav-link <%= activePage === 'books' ? 'active' : '' %>" href="/books"><i class="fas fa-book" style="font-size: 15px;"></i><span style="font-size: 15px;"><%= t('general.books') %></span></a></li>
            <% if(userRole === 'Viewer' || userRole === 'Moderator') {} else { %>
            <li class="nav-item"><a class="nav-link <%= activePage === 'upload' ? 'active' : '' %>" href="/upload"><i class="fas fa-upload" style="font-size: 15px;"></i><span style="font-size: 15px;"><%= t('upload.upload_song') %></span></a></li>
            <% if(userRole === 'Editor') {} else{ %>
            <li class="nav-item"><a class="nav-link <%= activePage === 'settings' ? 'active' : '' %>" href="/settings"><i class="fas fa-cog" style="font-size: 15px;"></i><span style="font-size: 15px;"><%= t('general.settings') %></span></a></li>
            <% } %>
            <% } %>
            <li class="nav-item"></li>
        </ul>
        <!-- <div class="text-center d-none d-md-inline"><button class="btn rounded-circle border-0" id="sidebarToggle" type="button"></button></div> -->
    </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sidebar = document.querySelector('nav');

            function handleClickOutside(event) {
                // Check if the click is outside the sidebar
                if (sidebar.contains(event.target) && window.innerWidth < 768) {
                    sidebar.classList.add('toggled');
                }
            }

            // Handle clicks outside the sidebar
            document.addEventListener('click', handleClickOutside);

    });
</script>