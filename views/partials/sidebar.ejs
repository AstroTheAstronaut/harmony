            <li class="nav-item"><a class="nav-link <%= activePage === 'books' ? 'active' : '' %>" href="/books"><i class="fas fa-book" style="font-size: 15px;"></i><span style="font-size: 15px;"><%= t('general.books') %></span></a></li>
            <% if (hasPermission('access_schedule')) { %>
                <li class="nav-item"><a class="nav-link <%= activePage === 'schedule' ? 'active' : '' %>" href="/schedule"><i class="fas fa-clipboard-list" style="font-size: 19px;"></i><span style="font-size: 15px;"><%= t('general.schedule') %></span></a></li>
            <% } %>
            <% if(hasPermission('upload_song')){ %>
            <li class="nav-item"><a class="nav-link <%= activePage === 'upload' ? 'active' : '' %>" href="/upload"><i class="fas fa-upload" style="font-size: 15px;"></i><span style="font-size: 15px;"><%= t('upload.upload_song') %></span></a></li>
            <% if(hasPermission('access_settings')){ %>
            <li class="nav-item"><a class="nav-link <%= activePage === 'settings' ? 'active' : '' %>" href="/settings"><i class="fas fa-cog" style="font-size: 15px;"></i><span style="font-size:1rem;"><%= t('general.settings') %></span></a></li>
            <% } %>
            <% } %>
            <% if(hasPermission('view_notifications')){ %>
                <li class="nav-item"><a class="nav-link <%= activePage === 'notifications' ? 'active' : '' %>" href="/notifications"><i class="fas fa-bell" style="font-size: 15px;"></i><span style="font-size: 15px;"><%= t('general.notifications') %></span></a></li>
            <% } %>
            <% if(hasPermission('superuser_access')){ %>
                <li class="nav-item"><a class="nav-link <%= activePage === 'superuser' ? 'active' : '' %>" href="/superuser"><i class="fa-brands fa-superpowers" style="font-size: 15px;"></i><span style="font-size: 15px;">Superuser</span></a></li>
