        </a>
        <hr class="sidebar-divider my-0">
        <ul class="navbar-nav text-light" id="accordionSidebar">
            <li class="nav-item"><a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/"><i class="fas fa-tachometer-alt" style="font-size: 15px;"></i><span style="font-size: 15px;"><%= t('general.home') %></span></a></li>
