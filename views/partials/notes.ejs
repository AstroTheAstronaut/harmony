<link rel="stylesheet" type="text/css" href="/styles/notes.css" />
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="text-primary fw-bold m-0">Notes</h6>
            <a href="#"><i class="fas fa-plus fa-fw"></i></a>
        </div>
    </div>
    <ul class="list-group list-group-flush" id="notes-list">
        <li class="list-group-item list-group-item-action">
            <div class="d-flex align-items-center justify-content-between">
                <div class="note-content">
                    <h6 class="mb-0 note-text d-inline">
                        <strong>Momentan cautatul nu merge pe mobile.</strong>
                    </h6>
                    <span class="text-xs note-timestamp d-inline">XX:XX</span>
                </div>
                <div class="icon-group">
                    <a href="#" class="icon-link"><i class="fa-regular fa-square fa-fw"></i></a>
                    <a href="#" class="icon-link"><i class="fas fa-trash-can fa-fw"></i></a>
                    <a href="#" class="icon-link"><i class="fas fa-thumbtack fa-fw"></i></a>
                </div>
            </div>
        </li>
        <li class="list-group-item list-group-item-action">
            <div class="row g-0 align-items-center">
                <div class="col me-2">
                    <input type="text" id="add-note-input" class="form-control" placeholder="Start typing to add a note ..." />
                </div>
            </div>
        </li>
    </ul>
</div>
<script src="/scripts/notes.js"></script>
