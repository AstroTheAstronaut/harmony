<div class="fade modal" role="dialog" aria-hidden="true" aria-labelledby="newScheduleModalLabel" id="newScheduleModal"
        tabindex="-1">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createNewScheduleLabel">Create a new schedule</h5>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <p>You are about to create a new schedule.</p>
                        <p>To continue, please enter the details below:</p>
                        <label for="nameLabel">Name:</label>
                        <input type="text" class="form-control" id="nameInput" placeholder="Enter schedule name" required>
                        <label for="descriptionLabel">Description:</label>
                        <textarea class="form-control" id="descriptionInput" placeholder="Enter schedule description (optional)"></textarea>
                        <label for="biblePassageLabel">Bible Passage:</label>
                        <input type="text" class="form-control" id="biblePassageInput" placeholder="Enter Bible passage (optional)">
                        <label for="typeLabel">Type:</label>
                        <select class="form-control" id="typeSelect" required>
                            <option value="" disabled selected>Select the type of schedule</option>
                            <option value="youth">Youth</option>
                            <option value="church">Church</option>
                            <option value="mission">Mission</option>
                            <option value="special">Special</option>
                            <option value="free">Free</option>
                        </select>
                        <label for="targetChurchLabel">Target church:</label>
                        <input type="text" class="form-control" id="targetChurchInput" placeholder="Enter target church (optional)">
                        <label for="expiryDateLabel">Expiry Date:</label>
                        <input type="date" class="form-control" id="expiryDateInput" required>
                        <input type="text" class="form-control" id="creatorUidInput" value="<%= user.user_uid %>" hidden>
                        <label for="visibilityLabel">Visibility:</label>
                        <select class="form-control" id="visibilitySelect" required>
                            <option value="" disabled selected>Select the visibility of the schedule</option>
                            <option value="public">Public</option>
                            <option value="private">Private</option>
                        </select>
                        
                    </div>
                    
                    <!-- <p class="mt-3">The following schedule will be created:</p>
                    <div class="card scheduleInfo-card">
                        <div class="card-body align-items-center" id="scheduleInfo-card">
                            <p><strong>Name:</strong> <span id="namePreview">N/A</span></p>
                            <p><strong>Type:</strong> <span id="typePreview">N/A</span></p>
                            <p><strong>Target Church:</strong> <span id="targetChurchPreview">N/A</span></p>
                            <p><strong>Expiry Date:</strong> <span id="expiryDatePreview">N/A</span></p>
                            <p><strong>Visibility:</strong><span id="visibilityPreview"></span></p>
                        </div>
                    </div> -->
                </div>

                <!-- <div class="modal-footer">
                    <button type="button" class="btn btn-success modal-button-black" id="submitScheduleBtn" disabled onclick="pushRequest()">Create schedule</button>
                </div> -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-success modal-button-black" id="submitScheduleBtn" disabled onclick="pushRequest()">Create schedule</button>
                </div>
            </div>
        </div>
    </div>