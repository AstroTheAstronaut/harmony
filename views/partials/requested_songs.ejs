<%if (userRole === 'Viewer'){} else { %>
    <div class="col">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="text-primary fw-bold m-0"><%= t('messages.requested_songs') %>:</h6>
                <form action="/remove-all-requests" method="post" style="display: inline;">
                    <button type="submit" class="btn btn-danger btn-sm"><%= t('general.remove_all_requests') %></button>
                </form>
            </div>
            <ul class="list-group list-group-flush">
                <% if (requestedSongs.length> 0) { %>
                    <% requestedSongs.forEach(song=> { %>
                        <li class="list-group-item">
                            <div class="row">
                                <div class="col-auto align-self-center me-2">
                                    <a class="link-dark text-decoration-none"
                                        href="/song-view/<%= song.song_uid %>">
                                        <strong>
                                            <% if(song.book_song_number) { %>
                                                <%= song.book_song_number %>. <%= song.title%>
                                                        <% } else { %>
                                                            <%= song.title %>
                                                                <% } %>
                                        </strong>
                                    </a>
                                    <% if (song.artist) { %> - <%= song.artist %>
                                            <% } %>
                                                <span class="text-xs ms-2">
                                                    <%= song.request_time %>
                                                </span>
                                                <% if (song.book_song_number) { %>
                                                    <span
                                                        class="badge rounded-pill bg-primary ms-2">
                                                        <%= t('book.book') %>: <%= song.bo_name %>
                                                    </span>
                                                    <% } else { %>
                                                        <span
                                                            class="badge rounded-pill bg-primary ms-2">
                                                            <%= t('book.book') %>: <%= t('none') %>
                                                        </span>
                                                        <% } %>
                                </div>
                                <% if(userRole === 'Editor') {} else{ %>
                                <div class="col-auto me-2 text-end ms-auto">
                                    <form action="/remove-requested" method="post"
                                        style="display: inline;">
                                        <input type="hidden" name="request_id"
                                            value="<%= song.request_id %>">
                                        <button type="submit"
                                            class="btn btn-danger btn-sm"><%= t('general.remove_request') %></button>
                                    </form>
                                </div>
                                <% } %>
                            </div>
                        </li>
                        <% }) %>
                            <% } else { %>
                                <p class="text-center"><%= t('messages.no_requests_yet') %></p>
                                <% } %>
            </ul>
        </div>
    </div>
    <script>
        async function removeAllRequests() {
        try {
            const response = await fetch('/remove-all-requests', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (response.ok) {
                window.location.href = '/'; // Redirect after success
            } else {
                console.error('Error removing all requests');
                alert('Error removing all requests');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error removing all requests');
        }
    }
    </script>
    <% } %>