<div class="card shadow mb-4">
                            <div class="card-header py-3">
                                <h6 class="text-primary fw-bold m-0"><%= t('superuser.registration_codes') %></h6>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold m-0"><%= t('superuser.active_registration_codes') %>:</h6>
                                <button type="button" id="createNewRegCodeButton" class="btn btn-sm btn-outline-secondary" title="Create new code" data-bs-toggle="modal" data-bs-target="#createNewRegCodeButtonModal">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                                </div>

                                <% if (activeCodes.length === 0) { %>
                                <p class="text-muted">No active registration codes.</p>
                                <% } else { %>
                                <% activeCodes.forEach((code, index) => { %>
                                    <div class="card my-2">
                                    <div class="card-header d-flex justify-content-between align-items-center"
                                        data-bs-toggle="collapse"
                                        href="#collapseActive<%= index %>"
                                        role="button"
                                        aria-expanded="false"
                                        aria-controls="collapseActive<%= index %>">
                                        <span><strong><%= code.code %></strong></span>
                                        <span class="badge bg-success">Created</span>
                                    </div>
                                    <div class="collapse" id="collapseActive<%= index %>">
                                        <div class="card-body">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item"><strong>Created At:</strong> <%= code.createdAt.toLocaleString() %></li>
                                            <li class="list-group-item"><strong>Expires At:</strong> <%= code.expiryDate.toLocaleString() %></li>
                                            <li class="list-group-item"><strong>Role:</strong> <%= code.role %></li>
                                            <li class="list-group-item"><strong>Email:</strong> <%= code.email || 'No email' %></li>
                                            <li class="list-group-item d-flex gap-2">
                                                <button
                                                    class="btn-danger btn-sm btn flex-fill"
                                                    data-code-id="<%= code._id %>"
                                                    data-code="<%= code.code %>"
                                                    data-action="disableRegistrationCode"
                                                    onclick="disableRegistrationCode(this)"
                                                    title="Disable this code">
                                                    <i class="fa-solid fa-ban"></i> Disable code
                                                </button>
                                            </li>
                                        </ul>
                                        </div>
                                    </div>
                                    </div>
                                <% }) %>
                                <% } %>
                                <hr>
                                <h6 class="fw-bold mt-3 mb-2"><%= t('superuser.expired_or_used_codes') || "Expired / Used Registration Codes" %>:</h6>

                                <% if (expiredCodes.length === 0) { %>
                                <p class="text-muted">No expired or used registration codes.</p>
                                <% } else { %>
                                <% expiredCodes.forEach((code, index) => { %>
                                    <div class="card my-2">
                                    <div class="card-header d-flex justify-content-between align-items-center"
                                        data-bs-toggle="collapse"
                                        href="#collapseExpired<%= index %>"
                                        role="button"
                                        aria-expanded="false"
                                        aria-controls="collapseExpired<%= index %>">
                                        <span><strong><%= code.code %></strong></span>
                                        <span class="badge <%= code.isUsed ? 'bg-warning' : 'bg-danger' %>">
                                        <%= code.isUsed ? 'Used' : 'Expired' %>
                                        <%= code.isDisabled ? ' (Disabled)' : '' %>
                                        </span>
                                    </div>
                                    <div class="collapse" id="collapseExpired<%= index %>">
                                        <div class="card-body">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item"><strong>Created At:</strong>
                                                <%= code.createdAt ? new Date(code.createdAt).toLocaleString() : 'Unknown' %>
                                            </li>

                                            <li class="list-group-item">
                                                <% if (code.isExpired) { %>
                                                    <strong>Expired At:</strong>
                                                    <%= code.expiryDate ? new Date(code.expiryDate).toLocaleString() : 'No expiry' %>
                                                <% } else if (code.isDisabled) { %>
                                                    <strong>Disabled At:</strong>
                                                    <%= code.disabledAt ? new Date(code.disabledAt).toLocaleString() : 'Not disabled' %>
                                                <% } %>
                                            </li>

                                            <li class="list-group-item"><strong>Role:</strong> <%= code.role %></li>
                                            <li class="list-group-item"><strong>Email:</strong> <%= code.email || 'No email' %></li>
                                        </ul>
                                        </div>
                                    </div>
                                    </div>
                                <% }) %>
                                <% } %>

                                <div class="text-end mt-3">
                                <a href="/superuser/regcodes" class="text-decoration-none small">
                                    View all codes
                                </a>
                                </div>
                            </div>
                            </div>

<div id="disableRegCodeModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="disableRegCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="disableRegCodeModalLabel">Disable Registration Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to <strong>disable</strong> this registration code?</p>
                <p>This action cannot be undone easily.</p>
                <p>Please type the registration code below to confirm:</p>

                <div class="card uuid-card my-2">
                    <div class="card-body text-center">
                        <div><strong>Registration Code:</strong> <span id="regCodeDisplay"></span></div>
                        <div><strong>Role:</strong> <span id="regCodeRoleDisplay"></span></div>
                    </div>
                </div>

                <!-- Reason input -->
                <div class="form-group mb-3">
                    <label for="disableReason">Reason for disabling:</label>
                    <textarea class="form-control" id="disableReason" rows="3" placeholder="Enter reason (optional)"></textarea>
                </div>

                <div class="form-group">
                    <label for="confirmRegCode">Type the registration code to confirm:</label>
                    <input type="text" class="form-control" id="confirmRegCode" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmDisableButton" class="btn btn-danger" disabled>Disable Code</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="manageUserModal" tabindex="-1" role="dialog" aria-labelledby="manageUserModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="manageUserModalLabel">Confirm User Action</h5>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to <strong id="userActionType">perform this action</strong> on this user?</p>
        <p>This action cannot be undone easily.</p>
        <p>Please type the username below to confirm:</p>

        <div class="card uuid-card my-2">
          <div class="card-body text-center">
            <div><strong>User UID:</strong> <span id="userUIDDisplay"></span></div>
            <div><strong>Username:</strong> <span id="usernameDisplay"></span></div>
          </div>
        </div>

        <!-- Reason input -->
        <div class="form-group mb-3">
          <label for="punishmentReason">Reason for action:</label>
          <textarea class="form-control" id="punishmentReason" rows="3" placeholder="Enter reason (optional)"></textarea>
        </div>

        <!-- Duration input, hidden by default -->
        <div class="form-group mb-3" id="punishmentDurationGroup" style="display:none;">
          <label for="punishmentDuration">Duration (days):</label>
          <label for="banDurationClause" id ="banDurationClause" style="display:none;">If you don't enter a ban duration, it will be permanent.</label>
          <input type="number" min="1" class="form-control" id="punishmentDuration" placeholder="Enter number of days">
        </div>

        <div class="form-group">
          <label for="confirmUserUID">Type the username to confirm:</label>
          <input type="text" class="form-control" id="confirmUsername" required>
        </div>
      </div>
      <div class="modal-footer">
        <button id="confirmUserActionBtn" class="btn btn-danger" disabled>Confirm</button>
      </div>
    </div>
  </div>
</div>